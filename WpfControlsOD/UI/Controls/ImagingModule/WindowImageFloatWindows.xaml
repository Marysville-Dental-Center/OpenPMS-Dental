<Window x:Class="WpfControls.UI.WindowImageFloatWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfControls.UI"
        mc:Ignorable="d"
        Height="195" Width="345" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="None" WindowStartupLocation="Manual" FontSize="11.5">
	<!--The new look (UI-4c-1, docs/port-notes/UI-4c.md): a drop-down menu (SurfaceRaised with a 1 px Stroke border, was gray 128); the snap areas
	from UiLookImaging.SetSnapArea.-->
	<Grid x:Name="grid" x:FieldModifier="internal">
		<Border x:Name="borderMain" x:FieldModifier="internal" BorderThickness="1" BorderBrush="{x:Static local:UiLookImaging.BrushStroke}" Background="{x:Static local:UiLookImaging.BrushSurfaceRaised}" Focusable="True"/>
		<Border x:Name="borderWhiteBlock" x:FieldModifier="internal" Width="100" Height="5" Background="{x:Static local:UiLookImaging.BrushSurfaceRaised}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,0,0,0"/>
		<local:Button x:Name="butDockThis" Width="77" Height="24" Margin="14,83,0,0" Text="Dock This" Click="butDockThis_Click"  />
		<local:Button x:Name="butCloseOthers" Width="77" Height="24" Margin="14,112,0,0" Text="Close Others" Click="butCloseOthers_Click"  />
		<local:Button x:Name="butShowAll" Width="77" Height="24" Margin="14,141,0,0" Text="Show All" Click="butShowAll_Click" />
		<local:ListBox x:Name="listBoxWindows" Width="209" Height="20" Margin="115,104,0,0" />
		<local:Label x:Name="labelWindows" Width="191" Height="18" Margin="114,84,0,0" Text="Open Images" VAlign="Bottom" />
	</Grid>

</Window>
