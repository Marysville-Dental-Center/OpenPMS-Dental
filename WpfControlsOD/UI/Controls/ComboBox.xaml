<UserControl x:Class="WpfControls.UI.ComboBox"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
		xmlns:local="clr-namespace:WpfControls.UI"
		mc:Ignorable="d" 
		d:DesignWidth="100" d:DesignHeight="21">
	<UserControl.Style>
		<Style>
			<Setter Property="local:ComboBox.HorizontalAlignment" Value="Left"/>
			<Setter Property="local:ComboBox.VerticalAlignment" Value="Top"/>
		</Style>
	</UserControl.Style>
	<!--Section 3.6 (UI-4b-1): SurfaceRaised (or ColorBack) with 4 px corners, a 1 px StrokeStrong border (StrokeStrongHover on hover, Stroke
	disabled), the Fluent chevron 6 px from the right; the focus line is the focus visual style (UiLookLists.KeyFocusVisualStyleCombo).-->
    <Grid Name="grid" x:FieldModifier="internal" Background="Transparent">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/><!--Text-->
			<ColumnDefinition Width="14"/><!--Dropdown-->
		</Grid.ColumnDefinitions>
		<Border Name="borderBack" x:FieldModifier="internal" Grid.ColumnSpan="2" CornerRadius="4" SnapsToDevicePixels="True"/>
		<TextBlock Name="textBlock" x:FieldModifier="internal" VerticalAlignment="Center" Margin="2,0,0,0"/>
		<Path Name="pathChevron" x:FieldModifier="internal" Grid.ColumnSpan="2" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
		<Border Name="border" x:FieldModifier="internal" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True"/>
	</Grid>
</UserControl>
