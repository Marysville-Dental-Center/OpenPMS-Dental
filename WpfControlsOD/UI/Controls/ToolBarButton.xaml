<UserControl x:Class="WpfControls.UI.ToolBarButton"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
		xmlns:local="clr-namespace:WpfControls.UI"
		mc:Ignorable="d" 
		d:DesignHeight="25" d:DesignWidth="90">
	<Grid x:Name="grid" x:FieldModifier="internal">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/><!--Image. if no image in first column, its width will be 0.-->
			<ColumnDefinition Width="*"/><!--Text-->
			<ColumnDefinition Width="14"/><!--Dropdown. if not a dropdown button, then its width will be 0.-->
			<ColumnDefinition Width="1"/><!--Line on right-->
		</Grid.ColumnDefinitions>
		<!--UI-6 (docs/specs/ui-refresh-plan.md section 3.6, Toolbars): flat. The grid is transparent (the toolbar's SurfaceSubtle shows) but hit-testable;
		the button's shape is borderOverlay, 1 px in from the bounds with 4 px corners: SubtleHover, SubtlePressed, or AccentSubtle with an Accent border
		when toggled (ToolBarButton.SetColors).-->
		<Grid.Background>
			<SolidColorBrush Color="Transparent"/>
		</Grid.Background>
		<Border x:Name="borderOverlay" x:FieldModifier="internal" Grid.ColumnSpan="3" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Margin="1"/><!--No content because it overlays without shifting anything under it.-->
		<Grid x:Name="gridImage" x:FieldModifier="internal"/>
		<TextBlock Grid.Column="1" x:Name="textBlock" x:FieldModifier="internal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,4,0"/>
		<Border x:Name="borderDropDown" x:FieldModifier="internal" Grid.Column="2" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0,4,4,0" Margin="0,1,1,1"/><!--the drop-down part's overlay when it is pressed.-->
		<!--The drop-down arrow: the 12 px Fluent chevron (UI-7a), its geometry set in code.-->
		<Path Grid.Column="2" x:Name="pathChevron" x:FieldModifier="internal" Width="12" Height="12" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
		<!--Column 3 keeps its 1 px (the buttons' widths do not change); the line that was drawn there is gone: no lines between buttons.-->
	</Grid>
</UserControl>
