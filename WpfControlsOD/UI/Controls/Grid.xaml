<UserControl x:Class="WpfControls.UI.Grid"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
		xmlns:local="clr-namespace:WpfControls.UI"
		mc:Ignorable="d" 
		d:DesignHeight="300" d:DesignWidth="300" SizeChanged="UserControl_SizeChanged">
	<UserControl.Style>
		<Style>
			<Setter Property="local:Grid.HorizontalAlignment" Value="Left"/>
			<Setter Property="local:Grid.VerticalAlignment" Value="Top"/>
		</Style>
	</UserControl.Style>
	<UserControl.Template>
		<ControlTemplate TargetType="UserControl">
			<ContentPresenter/>
		</ControlTemplate>
	</UserControl.Template>
	<!--The look of UI-5 (docs/port-notes/UI-5.md): the token brushes of GridLook. The title and header heights follow the font (set in code).-->
	<Border x:Name="borderOuter" x:FieldModifier="internal" BorderBrush="{x:Static local:GridLook.BrushStroke}" BorderThickness="1">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Border x:Name="borderTitle" x:FieldModifier="internal" Grid.ColumnSpan="2" Height="18" Background="{x:Static local:GridLook.BrushTitle}">
				<TextBlock x:Name="textTitle" x:FieldModifier="internal" Foreground="{x:Static local:GridLook.BrushTitleText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="Segoe UI" FontSize="14"><!--font 14 is 10.5pt-->
					Grid
				</TextBlock>
			</Border>
			<Border x:Name="borderHeaders" x:FieldModifier="internal" Grid.Row="1" Height="15" Background="{x:Static local:GridLook.BrushHeader}" BorderThickness="0,0,0,1" BorderBrush="{x:Static local:GridLook.BrushStroke}">
				<Canvas ClipToBounds="True">
					<Canvas x:Name="canvasHeaders" x:FieldModifier="internal" MouseLeftButtonDown="canvasHeaders_MouseLeftButtonDown"/>
				</Canvas>
			</Border>
			<Border x:Name="borderHeaderCorner" x:FieldModifier="internal" Grid.Row="1" Grid.Column="1" Height="15" Background="{x:Static local:GridLook.BrushHeader}" BorderThickness="1,0,0,1" BorderBrush="{x:Static local:GridLook.BrushStroke}"/>
			<Canvas x:Name="canvasView" x:FieldModifier="internal" Grid.Row="2" ClipToBounds="True" Background="{x:Static local:GridLook.BrushCell}" MouseRightButtonUp="canvasView_MouseRightButtonUp">
				<Canvas x:Name="canvasMain" x:FieldModifier="internal" Height="224" Width="252" Background="{x:Static local:GridLook.BrushCell}" MouseLeftButtonDown="canvasMain_MouseLeftButtonDown" MouseMove="canvasMain_MouseMove" MouseLeave="canvasMain_MouseLeave" MouseRightButtonUp="canvasMain_MouseRightButtonUp" MouseLeftButtonUp="canvasMain_MouseLeftButtonUp"/>
			</Canvas>
			<Border Grid.Column="1" Grid.Row="2" BorderThickness="1,0,0,0" BorderBrush="{x:Static local:GridLook.BrushStroke}">
				<ScrollBar x:Name="scrollV" x:FieldModifier="internal" Orientation="Vertical" Scroll="scrollV_Scroll"/>
			</Border>
			<Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{x:Static local:GridLook.BrushStroke}">
				<ScrollBar x:Name="scrollH" x:FieldModifier="internal" Orientation="Horizontal" Visibility="Collapsed" Scroll="scrollH_Scroll"/>
			</Border>
			<Border Grid.Row="3" Grid.Column="1" Background="#F0F0F0" BorderThickness="1,1,0,0" BorderBrush="{x:Static local:GridLook.BrushStroke}"/><!--the scroll bars' own grey-->
		</Grid>
	</Border>
</UserControl>
