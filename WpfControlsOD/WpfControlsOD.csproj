<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The WPF windows (Frms) and controls (UI) of the program, with the bridges and the logic behind them. With UseWPF the SDK's default globs
    build every .xaml file under this folder as a Page, compile every .cs file and embed every .resx file (bin\ and obj\ excepted), so a new
    window needs no edit here. Every other file under the folder is a None item unless an item below makes it something else. Only items with
    their own metadata are listed: the linked SharedAssemblyInfo.cs, the designer and generated files, the code-behind of each .xaml file, the
    class-based resource names and the WPF resources. x86 like the other projects (Directory.Build.props).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>WpfControls</RootNamespace>
    <AssemblyName>WpfControlsOD</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <UseWPF>true</UseWPF>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Native first (S3a-14n of the .NET 10 move, docs/port-notes/S3a-14.md): Schick CDR DICOM's automation interop and QuickBooks Desktop's
         QBFC 10 interop ("Required dlls"), with their types embedded as before S3a-13 and S3a-14, so neither interop file is copied or shipped.
         Used only by Bridges\SchickInProcess.cs and Bridges\QuickBooksInProcess.cs, the in-process paths of NativeFirstChooser; the 32-bit
         helper embeds them too for its modules, the fallback. -->
    <Reference Include="Interop.CDRDATALib">
      <HintPath>..\Required dlls\Interop.CDRDATALib.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.CDRDicom">
      <HintPath>..\Required dlls\Interop.CDRDicom.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.QBFC10">
      <HintPath>..\Required dlls\Interop.QBFC10.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.VisualBasic" />
    <!-- The WebView2 SDK, the version of Directory.Packages.props (UI\Controls\WebView2.xaml). Its build files are left out
         (ExcludeAssets="build"): in a library they would only copy the native WebView2Loader.dll into this output folder and every one that
         references it; the program and the tests that open WebView2 windows take it themselves (Directory.Build.targets). -->
    <PackageReference Include="Microsoft.Web.WebView2" ExcludeAssets="build" />
    <!-- Newtonsoft.Json, the version of Directory.Packages.props. -->
    <PackageReference Include="Newtonsoft.Json" />
    <Reference Include="ReachFramework" />
    <Reference Include="System.Printing" />
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <!-- The ReadOnlySpan<char> overloads of WeCantSpell.Hunspell's WordList need it to compile; SpellCheckL calls the string ones. -->
    <PackageReference Include="System.Memory" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\third-party\build\PdfSharp-gdi\PdfSharp-gdi.csproj" />
    <!-- The spell checker of every ODtextBox and TextRich (Logic\SpellCheckL.cs): a managed port of Hunspell, built from its source
         (third-party\build), no native DLL. MPL 1.1 / GPL 2.0 or later / LGPL 2.1 or later, used under the GPL/LGPL
         (THIRD-PARTY-NOTICES.txt). -->
    <ProjectReference Include="..\third-party\build\WeCantSpell.Hunspell\WeCantSpell.Hunspell.csproj" />
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\SparksToothChart\SparksToothChart.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <!-- The commands of the 32-bit helper's QuickBooks Desktop module (S3a-13 of the .NET 10 move), compiled into the helper and into this
         assembly, so Bridges\QuickBooks.cs and the module name them alike. Its type is internal. -->
    <Compile Include="..\OpenPmsDentalHelper32\QuickBooks\QuickBooksCommands.cs">
      <Link>Bridges\QuickBooksCommands.cs</Link>
    </Compile>
    <!-- The commands of the helper's Schick CDR and Guru modules (S3a-14), compiled into the helper and into this assembly, so
         Bridges\Schick.cs, Bridges\Guru.cs and the modules name them alike (and cross Guru's patient alike). Their types are internal.
         CDR DICOM's two interop files are referenced above for the in-process path (S3a-14n) and by the helper for the fallback. -->
    <Compile Include="..\OpenPmsDentalHelper32\Schick\SchickCommands.cs">
      <Link>Bridges\SchickCommands.cs</Link>
    </Compile>
    <Compile Include="..\OpenPmsDentalHelper32\Guru\GuruCommands.cs">
      <Link>Bridges\GuruCommands.cs</Link>
    </Compile>
    <!-- The command of the helper's Mediadent / CADI module (N64-A3), compiled into the helper and into this assembly, so Bridges\CADI.cs,
         Bridges\CADIInProcess.cs and the module send CADI the same values. Its types are internal. -->
    <Compile Include="..\OpenPmsDentalHelper32\Cadi\CadiCommands.cs">
      <Link>Bridges\CadiCommands.cs</Link>
    </Compile>
    <!-- The code-behind of each window and control belongs to its .xaml file (Frms\FrmAccountEdit.xaml.cs to FrmAccountEdit.xaml). -->
    <Compile Update="**\*.xaml.cs" DependentUpon="%(Filename)" />
    <Compile Update="Frame\FormSnap.Designer.cs">
      <DependentUpon>FormSnap.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- The class-based resource names (OpenPmsDental.FormFrame.resources, ...) come from DependentUpon: the two WinForms forms are in
         namespace OpenPmsDental, not in the root namespace. -->
    <EmbeddedResource Update="Frame\FormFrame.resx">
      <DependentUpon>FormFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Frame\FormSnap.resx">
      <DependentUpon>FormSnap.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- WPF resources in WpfControlsOD.g.resources (resources/editpencil.gif, ...), which the pages load by pack URI. -->
    <Resource Include="Resources\editPencil.gif" />
    <Resource Include="Resources\up.gif" />
    <Resource Include="Resources\down.gif" />
    <Resource Include="Resources\ExternalLink.png" />
    <Resource Include="Resources\Bullets_24x24.png" />
    <Resource Include="Resources\printSmall.gif" />
    <Resource Include="Resources\PracticeBooster.png" />
    <!-- The files above are Resource items only, not None items of the default glob as well. -->
    <None Remove="@(Resource)" />
  </ItemGroup>
</Project>
