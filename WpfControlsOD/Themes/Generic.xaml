<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WpfControls.UI">

	<!--The shared focus visual styles (UI-4a, docs/specs/ui-refresh-plan.md section 3.6): WPF shows them while a control has keyboard focus and
	Windows asks for keyboard cues. A plain control: a 2 px Accent ring inside its bounds, following its 4 px corners. An accent-filled control (the
	default button): the same ring outside a 1 px white inner ring. Controls take them through UiLook.SetFocusVisualStyle.-->
	<Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:UiLook}, ResourceId=FocusVisualStyle}">
		<Setter Property="Control.Template">
			<Setter.Value>
				<ControlTemplate>
					<Border BorderBrush="{x:Static local:UiLook.BrushAccent}" BorderThickness="2" CornerRadius="4" SnapsToDevicePixels="True"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:UiLook}, ResourceId=FocusVisualStyleOnAccent}">
		<Setter Property="Control.Template">
			<Setter.Value>
				<ControlTemplate>
					<Grid SnapsToDevicePixels="True">
						<Border BorderBrush="{x:Static local:UiLook.BrushAccent}" BorderThickness="2" CornerRadius="4"/>
						<Border BorderBrush="{x:Static local:UiLook.BrushTextOnAccent}" BorderThickness="1" CornerRadius="2" Margin="2"/>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--UI-4b-1 (docs/port-notes/UI-4b.md), the combo boxes, pickers and lists of section 3.6. The combo box's focus: a 2 px Accent line inside the
	bottom edge, inset 2 px at each end (inside the 4 px corners); WpfControls.UI.ComboBox takes it as its FocusVisualStyle.-->
	<Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:UiLookLists}, ResourceId=FocusVisualStyleCombo}">
		<Setter Property="Control.Template">
			<Setter.Value>
				<ControlTemplate>
					<Border Background="{x:Static local:UiLook.BrushAccent}" Height="2" VerticalAlignment="Bottom" Margin="2,0,2,0" SnapsToDevicePixels="True"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--The tree's expander: the Fluent chevron, right when collapsed and down when expanded, in TextSecondary (Text on hover), in the 16 px square
	of the Windows one.-->
	<Style x:Key="TreeViewItemExpanderUi" TargetType="{x:Type ToggleButton}">
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Width" Value="16"/>
		<Setter Property="Height" Value="16"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ToggleButton}">
					<Border Background="Transparent" Width="16" Height="16" Padding="2">
						<Path x:Name="path" Width="12" Height="12" Data="{x:Static local:UiLookLists.GeometryChevronRight}" Fill="{x:Static local:UiLookLists.BrushTextSecondary}"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="path" Property="Data" Value="{x:Static local:UiLookLists.GeometryChevronDown}"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="path" Property="Fill" Value="{x:Static local:UiLookLists.BrushText}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--The tree's items (WpfControls.UI.TreeViewItem): the row Transparent, hover RowHover, selected AccentSubtle with the 2 px selection bar in the
	row's first pixels (Accent while the tree has keyboard focus, Selector.IsSelectionActive; SelectionBarNoFocus without), the text in Text,
	TextSelected, TextDisabled. The Windows template's layout otherwise (the 19 px expander column, the children below); the header starts 2 px
	further right, after the bar.-->
	<Style TargetType="{x:Type local:TreeViewItem}">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Padding" Value="1,0,0,0"/>
		<Setter Property="Foreground" Value="{x:Static local:UiLookLists.BrushText}"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:TreeViewItem}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition MinWidth="19" Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition/>
						</Grid.RowDefinitions>
						<ToggleButton x:Name="Expander" ClickMode="Press" Style="{StaticResource TreeViewItemExpanderUi}"
							IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
						<Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
							<ContentPresenter x:Name="PART_Header" ContentSource="Header" Margin="2,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
						</Border>
						<Rectangle x:Name="bar" Grid.Column="1" Width="2" HorizontalAlignment="Left" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
						<ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"/>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsExpanded" Value="False">
							<Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
						</Trigger>
						<Trigger Property="HasItems" Value="False">
							<Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
						</Trigger>
						<Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{x:Static local:UiLookLists.BrushRowHover}"/>
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{x:Static local:UiLookLists.BrushAccentSubtle}"/>
							<Setter TargetName="bar" Property="Fill" Value="{x:Static local:UiLookLists.BrushSelectionBarNoFocus}"/>
							<Setter Property="Foreground" Value="{x:Static local:UiLookLists.BrushTextSelected}"/>
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsSelected" Value="True"/>
								<Condition Property="Selector.IsSelectionActive" Value="True"/>
							</MultiTrigger.Conditions>
							<Setter TargetName="bar" Property="Fill" Value="{x:Static local:UiLook.BrushAccent}"/>
						</MultiTrigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{x:Static local:UiLookLists.BrushTextDisabled}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--Group box (section 3.6): 1 px Stroke, 6 px corners, the title in Text where it was.-->
	<Style TargetType="{x:Type local:GroupBox}">
		<Setter Property="HorizontalAlignment" Value="Left"/>
		<Setter Property="VerticalAlignment" Value="Top"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:GroupBox}">
					<Grid>
						<TextBlock Text="{Binding Path=Text, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="6,0,0,0" Foreground="{x:Static local:UiLook.BrushText}"/>
						<ItemsPresenter/>
						<Border BorderBrush="{x:Static local:UiLook.BrushStroke}" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True"/>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<Grid />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="{x:Type local:Panel}">
		<Setter Property="HorizontalAlignment" Value="Left"/>
		<Setter Property="VerticalAlignment" Value="Top"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:Panel}">
					<Border Name="border" BorderThickness="1" Background="White">
						<ItemsPresenter/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<Grid/>
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="{x:Type local:PanelAutoScroll}">
	<Setter Property="HorizontalAlignment" Value="Left"/>
	<Setter Property="VerticalAlignment" Value="Top"/>
	<Setter Property="Template">
		<Setter.Value>
			<ControlTemplate TargetType="{x:Type local:PanelAutoScroll}">
				<Border Name="border" BorderThickness="1" Background="White">
					<ScrollViewer Name="scrollViewer">
						<ItemsPresenter/>
					</ScrollViewer>
				</Border>
			</ControlTemplate>
		</Setter.Value>
	</Setter>
	<Setter Property="ItemsPanel">
		<Setter.Value>
			<ItemsPanelTemplate>
				<Grid/>
			</ItemsPanelTemplate>
		</Setter.Value>
	</Setter>
</Style>
	<!--UI-4b-2 (docs/port-notes/UI-4b.md), the splitter of section 3.6: a GridSplitter inside a SplitContainer draws its area in Surface (the window's
	colour; its own Background, Silver in today's XAML, is today's look) with a 1 px Gridline line along its middle, Accent while it is dragged.-->
	<Style TargetType="{x:Type local:SplitContainer}">
		<Style.Resources>
			<Style TargetType="{x:Type GridSplitter}">
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type GridSplitter}">
							<Grid Background="{x:Static local:SplitContainer.BrushSurface}" SnapsToDevicePixels="True">
								<Rectangle x:Name="line" Fill="{x:Static local:SplitContainer.BrushGridline}" Height="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="ResizeDirection" Value="Columns">
									<Setter Property="Height" TargetName="line" Value="NaN"/>
									<Setter Property="Width" TargetName="line" Value="1"/>
									<Setter Property="VerticalAlignment" TargetName="line" Value="Stretch"/>
									<Setter Property="HorizontalAlignment" TargetName="line" Value="Center"/>
								</Trigger>
								<Trigger Property="IsDragging" Value="True">
									<Setter Property="Fill" TargetName="line" Value="{x:Static local:SplitContainer.BrushAccent}"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</Style.Resources>
		<Setter Property="HorizontalAlignment" Value="Left"/>
		<Setter Property="VerticalAlignment" Value="Top"/>
	</Style>
	<!--UI-6 (docs/specs/ui-refresh-plan.md section 3.6, Menus): the menu items of WpfControls.UI.Menu and ContextMenu. Drop-downs SurfaceRaised with a
	1 px Stroke border, item hover SubtleHover with 2 px corners, Gridline separators, the Fluent check mark and sub-menu arrow, disabled TextDisabled;
	the menu bar's items on its Surface, pressed (open) SubtlePressed. Brushes and glyphs come from the tokens through local:MenuItem's statics.-->
	<Style TargetType="{x:Type local:MenuItem}">
		<Style.Resources>
			<!--The menus' separators, found through the item's or the menu's style (a theme dictionary cannot answer MenuItem.SeparatorStyleKey).-->
			<Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type Separator}">
							<Border Height="1" Margin="4,3,4,3" Background="{x:Static local:MenuItem.BrushGridline}" SnapsToDevicePixels="True"/>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</Style.Resources>
		<Setter Property="Foreground" Value="{x:Static local:MenuItem.BrushText}"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:MenuItem}">
					<Grid>
						<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="2" Margin="1,0,1,0"/>
						<Grid x:Name="gridContent" Margin="4,2,4,2" VerticalAlignment="Center">
							<Grid.ColumnDefinitions>
								<ColumnDefinition x:Name="columnIcon" Width="Auto" MinWidth="16" SharedSizeGroup="MenuItemIconColumnGroup"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<ContentPresenter x:Name="icon" ContentSource="Icon" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
							<Path x:Name="check" Data="{x:Static local:MenuItem.GeometryCheckmark}" Fill="{TemplateBinding Foreground}" Width="16" Height="16"
								Stretch="None" VerticalAlignment="Center" Visibility="Collapsed"/>
							<ContentPresenter x:Name="header" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="8,0,8,0"/>
							<TextBlock x:Name="gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,4,0" VerticalAlignment="Center"/>
							<Path x:Name="arrow" Grid.Column="3" Data="{x:Static local:MenuItem.GeometryChevronRight}" Fill="{TemplateBinding Foreground}" Width="12"
								Height="12" Stretch="None" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"/>
						</Grid>
						<Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
							AllowsTransparency="True" Focusable="False" PopupAnimation="None">
							<Border Background="{x:Static local:MenuItem.BrushSurfaceRaised}" BorderBrush="{x:Static local:MenuItem.BrushStroke}" BorderThickness="1" Padding="2">
								<ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
									<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="Role" Value="TopLevelHeader">
							<Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
							<Setter TargetName="columnIcon" Property="MinWidth" Value="0"/>
							<Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
							<Setter TargetName="gesture" Property="Visibility" Value="Collapsed"/>
							<Setter TargetName="header" Property="Margin" Value="2,0,2,0"/>
							<Setter TargetName="gridContent" Property="Margin" Value="4,1,4,1"/>
							<Setter TargetName="border" Property="Margin" Value="0"/>
						</Trigger>
						<Trigger Property="Role" Value="TopLevelItem">
							<Setter TargetName="columnIcon" Property="MinWidth" Value="0"/>
							<Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
							<Setter TargetName="gesture" Property="Visibility" Value="Collapsed"/>
							<Setter TargetName="header" Property="Margin" Value="2,0,2,0"/>
							<Setter TargetName="gridContent" Property="Margin" Value="4,1,4,1"/>
							<Setter TargetName="border" Property="Margin" Value="0"/>
						</Trigger>
						<Trigger Property="Role" Value="SubmenuHeader">
							<Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
						</Trigger>
						<Trigger Property="Icon" Value="{x:Null}">
							<Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="check" Property="Visibility" Value="Visible"/>
							<Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
						</Trigger>
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="border" Property="Background" Value="{x:Static local:MenuItem.BrushSubtleHover}"/>
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="Role" Value="TopLevelHeader"/>
								<Condition Property="IsSubmenuOpen" Value="True"/>
							</MultiTrigger.Conditions>
							<Setter TargetName="border" Property="Background" Value="{x:Static local:MenuItem.BrushSubtlePressed}"/>
						</MultiTrigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{x:Static local:MenuItem.BrushTextDisabled}"/>
							<Setter TargetName="border" Property="Background" Value="Transparent"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--UI-6: WpfControls.UI.ContextMenu (section 3.6, Menus): SurfaceRaised with a 1 px Stroke border, the items as local:MenuItem's style above.-->
	<Style TargetType="{x:Type local:ContextMenu}">
		<Style.Resources>
			<!--The menus' separators, found through the item's or the menu's style (a theme dictionary cannot answer MenuItem.SeparatorStyleKey).-->
			<Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type Separator}">
							<Border Height="1" Margin="4,3,4,3" Background="{x:Static local:MenuItem.BrushGridline}" SnapsToDevicePixels="True"/>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</Style.Resources>
		<Setter Property="Foreground" Value="{x:Static local:MenuItem.BrushText}"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="Grid.IsSharedSizeScope" Value="True"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:ContextMenu}">
					<Border Background="{x:Static local:MenuItem.BrushSurfaceRaised}" BorderBrush="{x:Static local:MenuItem.BrushStroke}" BorderThickness="1" Padding="2">
						<ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
							<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
						</ScrollViewer>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--UI-4b-3 (docs/port-notes/UI-4b.md), the text boxes of section 3.6, taken by WpfControls.UI.TextBox, TextRich, TextVDate, TextVDouble, TextVInt,
	TextVTime (TextBoxBase) and TextPassword (PasswordBox) through UiLookText.ApplyTemplateLook. The Windows template's layout (a border of the box's
	BorderThickness around the PART_ContentHost scroll viewer), so the text stays where it was: SurfaceRaised or the box's own background, the 1 px
	border (StrokeStrong, set by ApplyTemplateLook), StrokeStrongHover on hover, Stroke when read only or disabled, Danger with a validation error
	(UiLookText.IsError); the text in Text (TextDisabled when disabled) unless the window set a colour; with keyboard focus a 2 px Accent line inside
	the bottom edge. Office content (ContentLook.IsPinned) keeps the Windows template.-->
	<ControlTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:UiLookText}, ResourceId=TemplateTextBox}" TargetType="{x:Type TextBoxBase}">
		<Grid>
			<Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"
				CornerRadius="{x:Static local:UiLookText.CornerRadiusText}" SnapsToDevicePixels="True">
				<ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
			</Border>
			<Border x:Name="focusLine" Background="{x:Static local:UiLookText.BrushAccent}" Height="{x:Static local:UiLookText.HeightFocusLine}" VerticalAlignment="Bottom"
				Margin="{x:Static local:UiLookText.MarginFocusLine}" SnapsToDevicePixels="True" IsHitTestVisible="False" Visibility="Collapsed"/>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger Property="IsEnabled" Value="True">
				<Setter Property="Foreground" Value="{x:Static local:UiLookText.BrushText}"/>
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="border" Property="BorderBrush" Value="{x:Static local:UiLookText.BrushStrokeStrongHover}"/>
			</Trigger>
			<Trigger Property="IsReadOnly" Value="True">
				<Setter TargetName="border" Property="BorderBrush" Value="{x:Static local:UiLookText.BrushStroke}"/>
			</Trigger>
			<Trigger Property="local:UiLookText.IsError" Value="True">
				<Setter TargetName="border" Property="BorderBrush" Value="{x:Static local:UiLookText.BrushDanger}"/>
			</Trigger>
			<Trigger Property="IsKeyboardFocused" Value="True">
				<Setter TargetName="focusLine" Property="Visibility" Value="Visible"/>
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter TargetName="border" Property="BorderBrush" Value="{x:Static local:UiLookText.BrushStroke}"/>
				<Setter Property="Foreground" Value="{x:Static local:UiLookText.BrushTextDisabled}"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<!--The password box: the same look (a PasswordBox has no read-only state).-->
	<ControlTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:UiLookText}, ResourceId=TemplatePasswordBox}" TargetType="{x:Type PasswordBox}">
		<Grid>
			<Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"
				CornerRadius="{x:Static local:UiLookText.CornerRadiusText}" SnapsToDevicePixels="True">
				<ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
			</Border>
			<Border x:Name="focusLine" Background="{x:Static local:UiLookText.BrushAccent}" Height="{x:Static local:UiLookText.HeightFocusLine}" VerticalAlignment="Bottom"
				Margin="{x:Static local:UiLookText.MarginFocusLine}" SnapsToDevicePixels="True" IsHitTestVisible="False" Visibility="Collapsed"/>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger Property="IsEnabled" Value="True">
				<Setter Property="Foreground" Value="{x:Static local:UiLookText.BrushText}"/>
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="border" Property="BorderBrush" Value="{x:Static local:UiLookText.BrushStrokeStrongHover}"/>
			</Trigger>
			<Trigger Property="IsKeyboardFocused" Value="True">
				<Setter TargetName="focusLine" Property="Visibility" Value="Visible"/>
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter TargetName="border" Property="BorderBrush" Value="{x:Static local:UiLookText.BrushStroke}"/>
				<Setter Property="Foreground" Value="{x:Static local:UiLookText.BrushTextDisabled}"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<!--The text box inside WpfControls.UI.DatePicker: the picker draws the box (as a combo box), so this one has no border colour of its own; the
	Windows layout, so the text stays where it was.-->
	<ControlTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:UiLookText}, ResourceId=TemplateTextBoxInner}" TargetType="{x:Type TextBoxBase}">
		<Border x:Name="border" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
			<ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsEnabled" Value="True">
				<Setter Property="Foreground" Value="{x:Static local:UiLookText.BrushText}"/>
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{x:Static local:UiLookText.BrushTextDisabled}"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
</ResourceDictionary>
