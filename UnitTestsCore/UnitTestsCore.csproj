<Project Sdk="Microsoft.NET.Sdk">
  <!--
    UnitTestsCore: the table-type helpers (TableTypes\*T.cs, MultiTypes, Misc) that the legacy UnitTests project uses to create its test
    rows. The SDK's default globs compile every .cs file under this folder (bin\ and obj\ excepted); every file there was a Compile item of
    the classic project, so nothing is listed. It is outside tests\, so tests\Directory.Build.props does not apply. It is a library of test
    helpers, not a test assembly: it takes the MSTest 4 framework only (MSTest.TestFramework, with its analyzers), not the adapter or the
    VSTest SDK (S4-1 of the .NET 10 move, docs/port-notes/S4-1.md).
    net10.0-windows x64 from Directory.Build.props and Directory.Build.Net.props since S3b-6 of the .NET 10 move (docs/port-notes/S3b-6.md):
    MiddleTierMockTests needs it, and every project it references is .NET 10 since S3b-3. Its .NET Framework references are part of the
    shared frameworks; Windows Forms for its System.Windows.Forms and System.Drawing types (and so that the restore prunes what the business
    library's Windows Desktop framework holds, S3b-3).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>UnitTestsCore</RootNamespace>
    <AssemblyName>UnitTestsCore</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- MSTest.TestFramework, the version of Directory.Packages.props. -->
    <PackageReference Include="MSTest.TestFramework" />
    <!-- Newtonsoft.Json, the version of Directory.Packages.props. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
