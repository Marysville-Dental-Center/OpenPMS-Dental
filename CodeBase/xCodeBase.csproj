<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>CodeBase</RootNamespace>
    <AssemblyName>CodeBase</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <!-- net10.0-windows x64 from Directory.Build.props and Directory.Build.Net.props (stage 3b, S3b-2 of docs/specs/net10-plan.md). The
         progress windows, message boxes, print preview and WebView2 control are Windows Forms; WPF as in the classic project's
         PresentationCore reference. The framework references flow to every project that references this one. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <DocumentationFile>bin\Release\CodeBase.xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The WebView2 SDK, the version of Directory.Packages.props for .NET 10 (1.0.4314.35). Its build files are used (S3b-0 item 5): for
         .NET they reference the lib_manual builds of the WebView2 assemblies, the same files the program gets, instead of the lib\net462
         ones NuGet would pick; its x64 WebView2Loader.dll lands flat (Directory.Build.targets). -->
    <PackageReference Include="Microsoft.Web.WebView2" />
    <!-- Not in the .NET 10 shared frameworks: WMI (System.Management) and the service control (System.ServiceProcess.ServiceController),
         the versions of Directory.Packages.props. The rest of the .NET Framework references (System.Data, System.Drawing, System.Security,
         System.Net.Http, ...) are part of Microsoft.NETCore.App and Microsoft.WindowsDesktop.App; Microsoft.VisualBasic is not used. -->
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
  <ItemGroup>
    <!-- Newtonsoft.Json, the version of Directory.Packages.props. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <!-- The protocol of the 32-bit helper program (S3a-13 of the .NET 10 move), compiled into the helper and into this assembly, so both ends
         read and write the same messages; Utilities\Helper32Client.cs uses it. Its types are internal. -->
    <Compile Include="..\OpenPmsDentalHelper32\Helper32Protocol.cs">
      <Link>Utilities\Helper32Protocol.cs</Link>
    </Compile>
    <Compile Update="Controls\ODWebView2.Designer.cs">
      <DependentUpon>ODWebView2.cs</DependentUpon>
    </Compile>
    <Compile Update="Controls\PrintPanel.Designer.cs">
      <DependentUpon>PrintPanel.cs</DependentUpon>
    </Compile>
    <Compile Update="Progress\FormProgressExtended.designer.cs">
      <DependentUpon>FormProgressExtended.cs</DependentUpon>
    </Compile>
    <Compile Update="Progress\FormProgressStatus.designer.cs">
      <DependentUpon>FormProgressStatus.cs</DependentUpon>
    </Compile>
    <Compile Update="Progress\ODProgressBar.designer.cs">
      <DependentUpon>ODProgressBar.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- The class-based resource names (CodeBase.PrintPanel.resources, ...) come from DependentUpon. -->
    <EmbeddedResource Update="Controls\PrintPanel.resx">
      <DependentUpon>PrintPanel.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Progress\FormProgressExtended.resx">
      <DependentUpon>FormProgressExtended.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Progress\FormProgressStatus.resx">
      <DependentUpon>FormProgressStatus.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Progress\ODProgressBar.resx">
      <DependentUpon>ODProgressBar.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Utilities\MsgBoxCopyPaste.resx">
      <DependentUpon>MsgBoxCopyPaste.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>
