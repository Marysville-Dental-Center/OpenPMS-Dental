<Project>
  <!--
    The versions of the NuGet packages the projects of this repository use (central package management,
    https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management). NuGet.props, which Microsoft.Common.props
    imports after Directory.Build.props, finds this file above every project and imports it. A project names a package with
    <PackageReference Include="Id" /> and no version; the version is the one below. Every package comes from the offline folder of
    nuget.config, never from a feed, and every restore writes or checks the project's packages.lock.json.

    As in Directory.Build.props, everything here is for SDK-style projects only. Microsoft.NET.Sdk sets UsingMicrosoftNETSdk before
    it imports Microsoft.Common.props; the classic Middle Tier project (OpenPmsDentalServer) and Direct2dWrapper.vcxproj never set it,
    so they see no central versions and build exactly as before.

    Stage 2 of the .NET 10 move (docs/specs/net10-plan.md), package S2-1: these packages replace the "Required dlls" files they are
    byte for byte (lib\net462, lib\net472 or lib\net48 of each package as the .NET Framework 4.8 build takes it, SHA-256 checked;
    docs/port-notes/S2-1.md). The projects that referenced a file by HintPath reference its package; a test project gets them through
    the projects it references. MySqlConnector and the WebView2 files kept their HintPaths until S2-2 and S2-3, the other files of
    "Required dlls" keep theirs.

    Package S2-2 (docs/port-notes/S2-2.md): MySqlConnector 2.6.2 replaces 2.3.7 (its HintPaths become this package), and the three
    Microsoft packages that were on 8.0.x, whose support ends on 2026-11-10, move to the current 10.0 patch, 10.0.15, with
    Microsoft.Bcl.AsyncInterfaces, which DependencyInjection.Abstractions 10.0.15 requires at 10.0.15.

    Package S2-3 (docs/port-notes/S2-3.md): Microsoft.Web.WebView2 1.0.2420.47, the same bits as before, replaces the HintPaths to its
    three assemblies. The program and the two test projects that open WebView2 windows take the native loader, WebView2Loader.dll (x86),
    from the package's build files, which Directory.Build.targets puts at the top of the output folder.

    Package S2-4 (docs/port-notes/S2-4.md): the files of these packages left "Required dlls". tools\Build-Release.ps1 checks each staged
    file of a package against the package's own file at the version OpenPmsDental\packages.lock.json names, so a version changed here
    reaches the release only through a restore that writes the new lock files.
  -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      The versions below also hold for the packages a package depends on (transitive pinning,
      https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management#transitive-pinning). Without it NuGet takes the
      lowest version a package asks for: MSAL 4.92 asks for System.Diagnostics.DiagnosticSource 6.0.1, System.Formats.Asn1 8.0.1 and
      System.Text.Json 6.0.10, Microsoft.Extensions.Logging.Abstractions 8.0.3 for System.Buffers 4.5.1 and System.Memory 4.5.5. With it
      every program and test gets the one file of each assembly that "Required dlls" held, which the binding redirects of the configs name.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--
      Two of these packages bring a Roslyn source generator, which the SDK hands the compiler of every project with the package anywhere in
      its graph: Microsoft.Extensions.Logging.Abstractions (LoggerMessage) and System.Text.Json (JsonSerializable). The files of "Required dlls"
      brought none, and the code relies on neither: the third-party source builds hold what the logging generator writes for PDFsharp and
      MigraDoc (third-party\build\SourceBuild.props), and a second copy would not compile. Each package's own switch takes its generator out
      again (its buildTransitive targets), so every project compiles as before.
      On .NET 10 (S3b-1's decision, docs/port-notes/S3b-1.md): Microsoft.Extensions.Logging.Abstractions is not part of the shared framework
      of a desktop project, so the package and its generator stay, and so does its switch. System.Text.Json is part of the shared framework:
      NuGet prunes the package from a net10.0-windows project's graph, so its build files, and with them this switch, never reach it; the
      compiler gets the framework's own generator from the targeting pack instead, which no switch turns off and which writes nothing for
      code without [JsonSerializable], as is all of this repository's. The switch therefore only matters for the projects that still target
      .NET Framework 4.8 on the integration branch, and goes when the last of them does (S3b-5).
    -->
    <DisableMicrosoftExtensionsLoggingSourceGenerator>true</DisableMicrosoftExtensionsLoggingSourceGenerator>
    <DisableSystemTextJsonSourceGenerator>true</DisableSystemTextJsonSourceGenerator>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <!-- The libraries: Bouncy Castle, the Google APIs with Gmail, MailKit and MimeKit, MSAL with its IdentityModel abstractions,
         MySqlConnector (the database client, S2-2), Json.NET and SSH.NET (Renci.SshNet.dll). -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="Google.Apis" Version="1.78.0" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageVersion Include="Google.Apis.Core" Version="1.78.0" />
    <PackageVersion Include="Google.Apis.Gmail.v1" Version="1.77.0.4295" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="MimeKit" Version="4.18.2" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.92.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.14.0" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- The WebView2 SDK (S2-3): Microsoft.Web.WebView2.Core, .WinForms and .Wpf (lib\net45) and the native WebView2Loader.dll. A .NET 10
         project takes 1.0.4314.35 (download batch D of the .NET 10 plan; S3b-0 item 5 proved its net10.0-windows x64 layout, S3b-4 moves the
         program to it); the condition is read with the project's final target framework, as every item condition is. -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.2420.47" Condition="'$(TargetFramework)' != '$(ODTargetFramework)'" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" Condition="'$(TargetFramework)' == '$(ODTargetFramework)'" />
    <!-- The support packages (polyfills) they and MySqlConnector use on the .NET Framework. The three Microsoft packages that were on
         8.0.x are on 10.0 since S2-2 (MySqlConnector 2.6.2 asks for 8.0.x; the pinning above gives it these); System.Security.Cryptography.Pkcs,
         the 26th identical file, was used by nothing and left "Required dlls" in S2-4. -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Bcl.Cryptography" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.15" />
    <PackageVersion Include="System.Formats.Asn1" Version="10.0.13" />
    <PackageVersion Include="System.IO.Pipelines" Version="10.0.14" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageVersion Include="System.Text.Encodings.Web" Version="10.0.14" />
    <PackageVersion Include="System.Text.Json" Version="10.0.14" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <!-- The WPF tooth chart's 3D helpers (TC-4, docs/specs/wpf-tooth-chart-plan.md; docs/port-notes/TC-4.md): Helix Toolkit 3.1.2, which
         SparksToothChart names. Its dependencies come from batch H and H2 of the offline folder and need no version here: every package of
         Helix's net48 closure that another package also brings is one of the nine above (Microsoft.Bcl.AsyncInterfaces,
         Microsoft.Extensions.DependencyInjection.Abstractions, Microsoft.Extensions.Logging.Abstractions, System.Buffers,
         System.Diagnostics.DiagnosticSource, System.Memory, System.Numerics.Vectors, System.Runtime.CompilerServices.Unsafe and
         System.Threading.Tasks.Extensions), which the transitive pinning above holds at these versions; the others (HelixToolkit,
         .Geometry, .Maths, CommunityToolkit.Common, .Diagnostics, .Mvvm, System.ComponentModel.Annotations and the System.* 4.3.x packages
         of System.Net.Http 4.3.4) have one version in the whole graph, so an unlocked restore of every project resolves them with no
         NU1603, NU1605, NU1608 or NU1107. -->
    <PackageVersion Include="HelixToolkit.Wpf" Version="3.1.2" />
    <!-- Test tools: Mono.Cecil reads assemblies in four test projects (S1-6); 0.11.6 for a test project on .NET 10 (batch D; S3b-5). -->
    <PackageVersion Include="Mono.Cecil" Version="0.10.3" Condition="'$(TargetFramework)' != '$(ODTargetFramework)'" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" Condition="'$(TargetFramework)' == '$(ODTargetFramework)'" />
    <!-- MSTest 4 (stage 4 of the .NET 10 move, package S4-1, docs/port-notes/S4-1.md; download batch B of 2026-11-14): the test framework,
         its VSTest adapter and the VSTest SDK, which tests\Directory.Build.props gives every test project (UnitTestsCore takes the framework
         only, NoHqTests names the three itself). MSTest.Analyzers comes with MSTest.TestFramework at the same version; it is listed so the
         analyzers' version is pinned here too. The rest of their closure (Microsoft.Testing.Platform and its extensions,
         Microsoft.TestPlatform.ObjectModel, Microsoft.CodeCoverage, System.Reflection.Metadata, System.Collections.Immutable,
         Microsoft.ApplicationInsights) has one version in the whole graph and stands in the test projects' lock files. -->
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.Analyzers" Version="4.5.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- System.ValueTuple: Microsoft.TestPlatform.ObjectModel (MSTest.TestAdapter's) asks for 4.5.0, whose lib\net47 file would be copied
         into a test project's output; MSAL and the other libraries already take 4.6.2, which brings no file for .NET Framework 4.7.1 and
         later (the framework's own copy binds, tests\LibraryBindingTests). Pinned here so every project resolves 4.6.2. -->
    <PackageVersion Include="System.ValueTuple" Version="4.6.2" />
    <!-- The .NET 10 build (stage 3b, download batch D of docs/specs/net10-plan.md section 5, in the offline folder since S3b-0; S3b-1 gives
         them their versions here, so a layer package names a package in its project and changes no shared file). The Windows libraries that
         left the .NET Framework: WMI (System.Management, CodeBase and the business library), the service controller, DPAPI
         (System.Security.Cryptography.ProtectedData, OpenPmsDentalStorage), the event log, domain login
         (System.DirectoryServices.AccountManagement with System.DirectoryServices.Protocols), voice perio charting (System.Speech, decision 13),
         System.CodeDom; the dashboard and graph charts (WinForms.DataVisualization, decision 10); the RDL <Code> compiler (Roslyn's Visual
         Basic compiler, decision 14); the XmlSerializers files (Microsoft.XmlSerializer.Generator, S3b-3 and S3b-4); the Middle Tier host and
         its tests (S3b-6). Each Microsoft id at the runtime version of the pinned SDK (10.0.15 with SDK 10.0.115); each SDK bump moves them
         with the runtime packs (section 2.4). -->
    <PackageVersion Include="System.Management" Version="10.0.15" />
    <PackageVersion Include="System.CodeDom" Version="10.0.15" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.15" />
    <PackageVersion Include="System.DirectoryServices.AccountManagement" Version="10.0.15" />
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.15" />
    <PackageVersion Include="System.Speech" Version="10.0.15" />
    <!-- The serial port of the BCBS Georgia dial-up terminal (OpenPmsDentalBusiness, Eclaims/TerminalConnector.cs; decision 11 keeps it):
         part of System.dll on .NET Framework, a package on .NET. Not in batch D; fetched by S3b-3 under the standing rule
         (od-tools/downloads/s3b3-system-io-ports-20261116, with its runtime.native closure, which names 16 non-Windows packages). -->
    <PackageVersion Include="System.IO.Ports" Version="10.0.15" />
    <PackageVersion Include="WinForms.DataVisualization" Version="1.10.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
    <!-- The C# compiler for tools\FormatSweep and tests\FormatParityTests (S3b-FMT, decision 24): the scan of every place that writes a
         double as text. Not in batch D; fetched by S3b-FMT under the standing rule (od-tools/downloads/s3bfmt-roslyn-csharp-20261116), the
         newest stable version, which pins Microsoft.CodeAnalysis.Common 5.12.0 exactly. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.XmlSerializer.Generator" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- The in-process test server of tests/MiddleTierHostTests (S3b-6): the package Mvc.Testing brings, from batch D's folder, named alone
         because the tests build the Middle Tier's own host on it instead of a WebApplicationFactory. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
  </ItemGroup>
</Project>
