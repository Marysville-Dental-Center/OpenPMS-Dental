<Project Sdk="Microsoft.NET.Sdk">
  <!-- The connection settings tool: changes this computer's database connection settings only, as an administrator
       (docs/specs/db-connection-security.md). Shipped in the program folder as OpenPmsDentalDbSettings.exe (ProgramNames.DbSettingsExeFileName). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows x64, self-contained, win-x64 (Directory.Build.props, Directory.Build.Net.props; S3b-2). Windows Forms windows. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OpenPmsDentalDbSettings</RootNamespace>
    <AssemblyName>OpenPmsDentalDbSettings</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\branding\app.ico</ApplicationIcon>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
  </ItemGroup>
</Project>
