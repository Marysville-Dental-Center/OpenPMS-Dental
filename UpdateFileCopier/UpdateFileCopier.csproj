<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows x64, self-contained, win-x64 (Directory.Build.props, Directory.Build.Net.props; S3b-2). Its one window is Windows
         Forms. OpenPmsDental.csproj copies its four files (.exe, .dll, .runtimeconfig.json, .deps.json) next to the program, whose runtime it
         uses. It has no app.config and no Settings.settings (S3b-4): the app.config held only the .NET Framework's startup section, and the
         settings file defined no setting, so nothing it reads would be missing where OpenFileCopier starts it from a temp folder without a
         .dll.config. -->

    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UpdateFileCopier</RootNamespace>
    <AssemblyName>UpdateFileCopier</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\branding\app.ico</ApplicationIcon>
    <LangVersion>8.0</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!--
      UpdateFileCopier replaces CodeBase.dll and the other program files while it runs, so it references none of them: it compiles its own
      copy of these files.
    -->
    <Compile Include="..\CodeBase\Progress\IODProgress.cs">
      <Link>IODProgress.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\DateTimeOD.cs">
      <Link>DateTimeOD.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\DateTime_.cs">
      <Link>DateTime_.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\Logger.cs">
      <Link>Logger.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\MiscUtils.cs">
      <Link>MiscUtils.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\MsgBoxCopyPaste.cs">
      <Link>MsgBoxCopyPaste.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODBuild.cs">
      <Link>ODBuild.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODCancellation.cs">
      <Link>ODCancellation.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODClassExtensions.cs">
      <Link>ODClassExtensions.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODClipboard.cs">
      <Link>ODClipboard.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODEnvironment.cs">
      <Link>ODEnvironment.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODException.cs">
      <Link>ODException.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODFileUtils.cs">
      <Link>ODFileUtils.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODInitialize.cs">
      <Link>ODInitialize.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODInvokeExtensions.cs">
      <Link>ODInvokeExtensions.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODThread.cs">
      <Link>ODThread.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODUIExtensions.cs">
      <Link>ODUIExtensions.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ODPrimitiveExtensions.cs">
      <Link>ODPrimitiveExtensions.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\Utilities\ProgramNames.cs">
      <Link>ProgramNames.cs</Link>
    </Compile>
    <Compile Include="..\OpenPmsDentalBusiness\Misc\ForkRelease\ReleaseManifest.cs">
      <Link>ReleaseManifest.cs</Link>
    </Compile>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <Compile Update="FormMain.Designer.cs">
      <DependentUpon>FormMain.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!--
      The linked .resx is named after the class of the .cs file beside it (EmbeddedResourceUseDependentUponConvention, on for .NET):
      CodeBase.MsgBoxCopyPaste.resources, the name MsgBoxCopyPaste's ComponentResourceManager looks up (typeof(MsgBoxCopyPaste)). Until S3b-2
      (net48, where the convention is off) it was named by its folder, UpdateFileCopier.MsgBoxCopyPaste.resources, which that lookup does not
      find.
    -->
    <EmbeddedResource Include="..\CodeBase\Utilities\MsgBoxCopyPaste.resx">
      <Link>MsgBoxCopyPaste.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="FormMain.resx">
      <DependentUpon>FormMain.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <!--
    Doubles and floats written as text as .NET Framework wrote them (package S3b-FMT of the .NET 10 move, decision 24 of
    docs/specs/net10-plan.md, docs/port-notes/S3b-FMT.md): CodeBase's ODNumberText.ToStringNetFx and AsNetFx, compiled in as an internal
    class (OD_NUMBERTEXT_LINKED), since this project does not reference CodeBase.
  -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);OD_NUMBERTEXT_LINKED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\CodeBase\Utilities\ODNumberTextNetFx.cs">
      <Link>Utilities\ODNumberTextNetFx.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
