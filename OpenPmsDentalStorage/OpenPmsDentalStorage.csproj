<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>OpenPmsDentalStorage</RootNamespace>
    <AssemblyName>OpenPmsDentalStorage</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- SSH.NET, at the version of Directory.Packages.props; its dependencies (BouncyCastle.Cryptography, Microsoft.Extensions.Logging.Abstractions
         and what .NET 10 does not have built in) come with its package. On .NET 10 the async interfaces (IAsyncDisposable, IAsyncEnumerable)
         are built in, so the Microsoft.Bcl.AsyncInterfaces package and the type that made every host copy it (Sftp.TypeAsyncInterfacesDependency)
         are gone (S3b-2). -->
    <PackageReference Include="SSH.NET" />
    <!-- ProtectedData (the SFTP upload stash, Sftp.cs) is part of Microsoft.WindowsDesktop.App, not of Microsoft.NETCore.App: this library
         uses no Windows Forms, so it names the package, at the version of Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
  </ItemGroup>
</Project>
