<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The tooth chart: the chart model, the Simple 2D engine and the WPF engine in Wpf3D (docs/specs/wpf-tooth-chart-plan.md). The DirectX 9 and
    OpenGL engines and their SharpDX and Tao references were retired in TC-9a (docs/port-notes/TC-9a.md). Every .cs file under this folder is
    compiled and every .resx embedded, so a package that adds a file does not edit this project file. No XAML page is left, so the project needs
    no UseWPF; the WPF assemblies it draws with are plain references below.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>SparksToothChart</RootNamespace>
    <AssemblyName>SparksToothChart</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="WindowsBase" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <Compile Update="ToothChart2D.Designer.cs">
      <DependentUpon>ToothChart2D.cs</DependentUpon>
    </Compile>
    <Compile Update="ToothChartWrapper.Designer.cs">
      <DependentUpon>ToothChartWrapper.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!--
      The class-based resource names (SparksToothChart.ToothChartWrapper.resources, ...) come from DependentUpon: a net48 project names a .resx
      without it by its folder (EmbeddedResourceUseDependentUponConvention is off for .NET Framework). The 2D chart's background is in
      SparksToothChart.ToothChart2D.resources, the tooth models (Resources\*.obj, through file references) in
      SparksToothChart.Properties.Resources.resources.
    -->
    <EmbeddedResource Update="ToothChart2D.resx">
      <DependentUpon>ToothChart2D.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ToothChartWrapper.resx">
      <DependentUpon>ToothChartWrapper.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <!-- The pen, eraser and colour changer cursors, as SparksToothChart.Pen.cur and so on (ToothChartWrapper.cs). -->
    <EmbeddedResource Include="ColorChanger.cur" />
    <EmbeddedResource Include="EraseCircle.cur" />
    <EmbeddedResource Include="Pen.cur" />
  </ItemGroup>
  <ItemGroup>
    <!-- The cursors are embedded above, and the classic project listed the old ChangeLog under no item; the SDK's None glob would list both. -->
    <None Remove="ChangeLog;*.cur" />
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!--
      Helix Toolkit 3.1.2 (TC-4, docs/port-notes/TC-4.md), the version of Directory.Packages.props, for the WPF chart's meshes (MeshBuilder);
      no chart code uses it yet.
      - PrivateAssets adds "compile" to the default (contentfiles, analyzers, build): the projects that reference this one get the files of
        Helix and its packages at run time (copied to their output, as before for every package), but do not compile against them. Only
        this project uses Helix. HelixToolkit.dll declares a public System.Runtime.CompilerServices.DefaultInterpolatedStringHandler of its
        own, which the compiler of a project that references the DLL uses for every interpolated string, and whose AppendFormatted has no
        "format" parameter: OpenPmsDental's "{value:N0}" strings then fail with CS1739.
      - ExcludeAssets="buildTransitive" keeps out the buildTransitive files of the packages Helix brings, here and in every project above:
        CommunityToolkit.Mvvm's (the only package below Helix with any, apart from the nine shared support packages, whose files come
        through the other projects as well) only set a property for its source generators and remove those generators for a compiler
        older than Roslyn 4; nothing in them is needed for net48. Directory.Build.targets keeps the package's generators away from the
        compiler.
    -->
    <PackageReference Include="HelixToolkit.Wpf" ExcludeAssets="buildTransitive" PrivateAssets="compile;contentfiles;analyzers;build" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
