<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The HL7 Windows service (OpenPmsDentalHL7.exe, ServiceHL7), with its debug window (ServiceManager installs it with sc.exe,
    CodeBase ServicesHelper; S3a-7). The SDK's default globs compile
    every .cs file and embed every .resx file under this folder (bin\ and obj\ excepted); only items with their own metadata are listed.
    AutoGenerateBindingRedirects is left to its default, on for an exe, as for the classic project: no reference conflicts today, so
    OpenPmsDentalHL7.exe.config is app.config as it is.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OpenPmsDentalHL7</RootNamespace>
    <AssemblyName>OpenPmsDentalHL7</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <!-- net10.0-windows x64, a self-contained win-x64 exe, from Directory.Build.props and Directory.Build.Net.props (stage 3b, S3b-3 of
         docs/specs/net10-plan.md; decision 20). Windows Forms for its debug window. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The service base class (ServiceBase) and the service control, not part of .NET 10's shared frameworks: the package, the version of
         Directory.Packages.props. The other .NET Framework references are part of the shared frameworks. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDentalStorage\OpenPmsDentalStorage.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <Compile Update="FormDebug.Designer.cs">
      <DependentUpon>FormDebug.cs</DependentUpon>
    </Compile>
    <Compile Update="ServiceHL7.Designer.cs">
      <DependentUpon>ServiceHL7.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="FormDebug.resx">
      <DependentUpon>FormDebug.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>
