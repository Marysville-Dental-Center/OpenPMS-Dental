<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for inventory tracking (docs/specs/inventory-tracking.md): the stock ledger and LevelOnHand, soonest-expiring lots first, receiving,
       counts and adjustments, stock counts saved while they are counted (resumed, posted, discarded), deducting and restoring when
       procedures are completed, un-completed and deleted, the implant lot on the procedure, the alerts, the opening-balance migration and
       the repair. Database tests use scratch MariaDB databases on 127.0.0.1 whose
       names start with test_inv_, synthetic rows only, and drop them afterwards. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms and WPF from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Its own [AssemblyInitialize] registers the code pages (tests\Shared\TestCodePages.cs; S3b-5). -->
    <ODOwnAssemblyInitialize>true</ODOwnAssemblyInitialize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
    <!-- For the window tests: the inventory windows are built in memory and never shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
  </ItemGroup>
</Project>
