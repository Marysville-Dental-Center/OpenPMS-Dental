<Project Sdk="Microsoft.NET.Sdk">
  <!-- The stage 1 gate's launch checks (the window checklist) run headless: the real program and its tools are started, driven without the
       visible desktop (the PC's screen may be locked; no SendInput, no person), captured with PrintWindow or RenderTargetBitmap, and closed.
       OPT-IN: without OPMS_WINDOW_CHECKS=1 every test is inconclusive, so Core and Full runs are unaffected. With it, the tests copy a dump of
       the synthetic test database (OPMS_WINDOW_CHECKS_DUMP) into a scratch database on the local MariaDB (127.0.0.1:3306, root, blank
       password) whose name starts with winchk_, run every check against that copy and drop it afterwards; results and screenshots go to
       OPMS_WINDOW_CHECKS_OUT. The program's own output folder (OpenPmsDental\bin\Debug) is the one started or loaded: the in-process checks run
       in the program's own process, its apphost started from that folder with TestProbeHost's startup hook, so its runtime, runtimeconfig,
       deps.json and .dll.config are the program's (WINCHK-5; a copy of TestProbeHost with the exe's config on .NET Framework, an AppDomain before
       S3a-8b of the .NET 10 move). Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms and WPF from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Its own [AssemblyInitialize] registers the code pages (tests\Shared\TestCodePages.cs; S3b-5). -->
    <ODOwnAssemblyInitialize>true</ODOwnAssemblyInitialize>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reads a built assembly's identity and attributes without loading it (AssemblyProbe; S3a-8b of the .NET 10 move: .NET has no
         reflection-only load). The NuGet package, from the offline package folder (nuget.config), at the version of
         Directory.Packages.props. -->
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>
  <ItemGroup>
    <!-- The program's managed assembly: OpenPmsDental.dll on .NET (the .exe is the apphost), OpenPmsDental.exe on .NET Framework (S3a-8), and
         the rule it uses for a file that is not built. -->
    <Compile Include="..\ProjectFileTests\ProgramAssembly.cs">
      <Link>ProgramAssembly.cs</Link>
    </Compile>
    <Compile Include="..\ProjectFileTests\BuildOutput.cs">
      <Link>BuildOutput.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- Group U of the UI refresh (package UI-0c of docs/specs/ui-refresh-plan.md): the ONE masking and hashing rule of the galleries, which the
         check U0 compares each picture with UiApproved\approved.tsv through (UI-0a), and the shared measuring files of the text-fit scan, which
         the group U walker measures and records bounds with (UI-0b, section 5.4). Linked, never copied: both tiers measure alike, and the before
         set's bounds record has one format. -->
    <Compile Include="..\..\tools\UiGallery\UiPictureMask.cs">
      <Link>UiPictureMask.cs</Link>
    </Compile>
    <Compile Include="..\UiRefreshTests\Shared\TextFitMeasurer.cs">
      <Link>Shared\TextFitMeasurer.cs</Link>
    </Compile>
    <Compile Include="..\UiRefreshTests\Shared\TextFitBoundsRecord.cs">
      <Link>Shared\TextFitBoundsRecord.cs</Link>
    </Compile>
    <Compile Include="..\UiRefreshTests\Shared\TextFitFontSwap.cs">
      <Link>Shared\TextFitFontSwap.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- Group U's windows (UI-0c): each row names a window, how the program opens it, and the tables it could write. Read from the repository by
         the checks and their self-tests. -->
    <None Include="UiGallery\windows.tsv" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- The in-process checks create the program's windows in the program's own process in OpenPmsDental\bin\Debug; the copies in this
         project's own output folder are never loaded there (the program's .deps.json binds every file of the program from its own folder). -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
    <!-- The process of an in-process session (TestProbeHost, S3a-8b of the .NET 10 move: .NET has no new AppDomain). -->
    <ProjectReference Include="..\TestProbeHost\TestProbeHost.csproj" />
  </ItemGroup>
</Project>
