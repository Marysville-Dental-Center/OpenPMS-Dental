<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Middle Tier host round trips (package S3b-6 of the .NET 10 move, docs/port-notes/S3b-6.md): the program's HTTP client
       (OpenDentalServerHttp, through RemotingClient and Meth) against the server's own ASP.NET Core application (OpenPmsDentalServer's
       ServerHost), on the in-process test server. Each server runs in an assembly load context of its own, with its own copy of the business
       layer's static state, as each ASMX application had its own AppDomain in IIS, so two servers on two databases and the client share
       nothing but the process. The scratch databases on the local MariaDB (127.0.0.1:3306, root, blank password) are built from
       db/init/new-database.sql with the fork migrations; their names start with s3b6_ht_ and are unique to the run, and they are dropped
       afterwards. With MIDDLETIER_TEST_URL the same tests run against a running server instead (the 3b gate's check of the Windows service;
       docs/port-notes/S3b-6.md, section 7). Synthetic data only. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- S3b-5 of docs/specs/net10-plan.md: every test project is .NET 10 (tests\Directory.Build.props). Windows Forms: the restore prunes
         what the business library's Windows Desktop framework holds (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Its own [AssemblyInitialize] registers the code pages (tests\Shared\TestCodePages.cs; S3b-5). -->
    <ODOwnAssemblyInitialize>true</ODOwnAssemblyInitialize>
  </PropertyGroup>
  <ItemGroup>
    <!-- The in-process test server (TestServer), from the offline package folder at the version of Directory.Packages.props. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- ASP.NET Core's shared framework named here too (it also flows from the server and TestHost), so the restore prunes the packages it
         holds, Microsoft.Extensions.Hosting and its configuration packages among them, which the server's Microsoft.Extensions.Hosting.
         WindowsServices names: the framework's copies serve, as in the server itself (the reason the projects above the business library name
         UseWindowsForms, S3b-3). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The rule for tests that check a built file (ConsoleServerTests starts the built server): inconclusive when it is not built, a failure
         with OPMS_REQUIRE_BUILD_OUTPUT=1. -->
    <Compile Include="..\ProjectFileTests\BuildOutput.cs">
      <Link>BuildOutput.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalServer\OpenPmsDentalServer.csproj" />
  </ItemGroup>
</Project>
