<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the 32-bit helper program (S3a-13 of the .NET 10 move, docs/port-notes/S3a-13.md, section 8): the protocol with a fake module
       (start, call, reply, error, a crash during a call, timeout, a missing helper, no helper left after the program's process ends, one helper
       per program process, the pipe's security), and the QuickBooks module against a fake of the QBFC session interfaces that records each
       call. No test opens a QuickBooks session or creates a real QBFC object; every helper a test starts is a copy of the helper in this
       folder, ended and deleted by the test. S3a-14 added the Schick CDR, Topaz and Guru modules against fakes of their vendor interfaces and the message pump between requests; S3a-14n the program's in-process paths of Schick CDR, QuickBooks Desktop and Guru against the same fakes. Every .cs file under this
       folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <!--
      QuickBooks Desktop's QBFC 10 interop ("Required dlls"), not embedded here: QuickBooksModule.cs (linked below) is compiled against its
      types, and the fake session (QbfcFake.cs) implements them. Copied into this test folder only; the helper embeds the types it uses and
      nothing ships the file.
    -->
    <Reference Include="Interop.QBFC10">
      <HintPath>..\..\Required dlls\Interop.QBFC10.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <!-- Schick CDR DICOM's interop (S3a-14), not embedded for the same reason: Schick\SchickModule.cs (linked below) is compiled against its
         types and the fakes (QbfcFake.cs makes fakes of any COM interface) implement them. No CDR object is created. -->
    <Reference Include="Interop.CDRDATALib">
      <HintPath>..\..\Required dlls\Interop.CDRDATALib.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.CDRDicom">
      <HintPath>..\..\Required dlls\Interop.CDRDicom.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Writes the any-CPU copy of this assembly into the helper's folder (Support\HelperCopy.cs), whose test module the 32-bit helper loads.
         The NuGet package, from the offline package folder (nuget.config), at the version of Directory.Packages.props. -->
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Guru\GuruModule.cs (linked below) builds MedVisorInterface.dll's structure with unsafe code (S3a-14). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The protocol, the module interface and the QuickBooks module, compiled as the helper compiles them: the module runs in the test's
         process against the fake session; the protocol's framing is tested on a memory stream. -->
    <Compile Include="..\..\OpenPmsDentalHelper32\Helper32Protocol.cs">
      <Link>Linked\Helper32Protocol.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\IHelper32Module.cs">
      <Link>Linked\IHelper32Module.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\QuickBooks\QuickBooksCommands.cs">
      <Link>Linked\QuickBooksCommands.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\QuickBooks\QuickBooksModule.cs">
      <Link>Linked\QuickBooksModule.cs</Link>
    </Compile>
    <!-- The Schick CDR, Topaz and Guru modules (S3a-14), run in the test's process against fakes of their vendor interfaces (Topaz: the
         synthetic control of tests\TopazStandIn), and the Windows functions and the message pump they use. -->
    <Compile Include="..\..\OpenPmsDentalHelper32\NativeMethods.cs">
      <Link>Linked\NativeMethods.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\MessagePumpingStream.cs">
      <Link>Linked\MessagePumpingStream.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\Schick\SchickCommands.cs">
      <Link>Linked\SchickCommands.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\Schick\SchickModule.cs">
      <Link>Linked\SchickModule.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\Guru\GuruCommands.cs">
      <Link>Linked\GuruCommands.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\Guru\GuruModule.cs">
      <Link>Linked\GuruModule.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\Topaz\TopazCommands.cs">
      <Link>Linked\TopazCommands.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\Topaz\TopazModule.cs">
      <Link>Linked\TopazModule.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\Topaz\TopazSigningWindow.cs">
      <Link>Linked\TopazSigningWindow.cs</Link>
    </Compile>
    <!-- The program's in-process paths of S3a-14n (native first), compiled here against the interop the fakes implement and against CodeBase's
         NativeFirstChooser, so each scenario of the module tests also runs on them and is compared with today's code. Guru's file declares
         MedVisorInterface.dll's functions, which no test calls. -->
    <Compile Include="..\..\WpfControlsOD\Bridges\SchickInProcess.cs">
      <Link>Linked\SchickInProcess.cs</Link>
    </Compile>
    <Compile Include="..\..\WpfControlsOD\Bridges\QuickBooksInProcess.cs">
      <Link>Linked\QuickBooksInProcess.cs</Link>
    </Compile>
    <Compile Include="..\..\WpfControlsOD\Bridges\GuruInProcess.cs">
      <Link>Linked\GuruInProcess.cs</Link>
    </Compile>
    <!-- N64-A3: the helper's Mediadent / CADI module and its command, and the program's in-process path (CADIInProcess.cs, with today's calls),
         run against a fake of CADI's automation object (Cadi\FakeCadi.cs) and compared with today's code (Cadi\CadiToday.cs). -->
    <Compile Include="..\..\OpenPmsDentalHelper32\Cadi\CadiCommands.cs">
      <Link>Linked\CadiCommands.cs</Link>
    </Compile>
    <Compile Include="..\..\OpenPmsDentalHelper32\Cadi\CadiModule.cs">
      <Link>Linked\CadiModule.cs</Link>
    </Compile>
    <Compile Include="..\..\WpfControlsOD\Bridges\CADIInProcess.cs">
      <Link>Linked\CADIInProcess.cs</Link>
    </Compile>
    <!-- N64-B6: a 64-bit program's late-bound QBFC session (QuickBooksLateBound.cs), run against the recording QBFC fakes reached through
         IDispatch-like dynamic calls (QuickBooks\LateBoundQbfc.cs) and compared call for call with today's code and the QBFC 10 path. -->
    <Compile Include="..\..\WpfControlsOD\Bridges\QuickBooksLateBound.cs">
      <Link>Linked\QuickBooksLateBound.cs</Link>
    </Compile>
  </ItemGroup>
  <!--
    S3b-8, the 32-bit TWAIN path: ImagingDeviceManager's TWAIN code as the helper compiles it (OpenPmsDentalHelper32.csproj), with its Helper32
    folder (the program's TwainHelperCaptureSession, TwainSourcePath and the router; the helper's TwainHelperServer), ImagingCapture's metadata
    parser and its TwainHelperChannel (the program's adapter on Helper32Client), and ImagingDeviceManagerTests' fake DSM and contract 1.1 source
    (FakeTwainDsm, FakeDsmMemory, FakeHelperSource). Twain\TwainTestDsm.cs gives the helper that fake (its any-CPU copy of this assembly, with
    the helper argument test-twain-dsm), and the tests run the same fake in this process for the in-process baseline. Compiled, not referenced: the any-CPU copy
    the 32-bit helper loads must not need the program's x64 ImagingDeviceManager.dll.
  -->
  <ItemGroup>
    <Compile Include="..\..\ImagingDeviceManager\**\*.cs"
             Exclude="..\..\ImagingDeviceManager\bin\**;..\..\ImagingDeviceManager\obj\**;..\..\ImagingDeviceManager\Properties\**;..\..\ImagingDeviceManager\EZTwain.cs;..\..\ImagingDeviceManager\EZTwain.Capture.cs;..\..\ImagingDeviceManager\Imaging\PdfPageWriter.cs">
      <Link>Linked\ImagingDeviceManager\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\..\ImagingCapture\Metadata\CaptureMetadata.cs;..\..\ImagingCapture\Metadata\CaptureMetadataParser.cs;..\..\ImagingCapture\Metadata\JsonReader.cs">
      <Link>Linked\ImagingCapture\Metadata\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\..\ImagingCapture\Session\TwainHelperChannel.cs">
      <Link>Linked\ImagingCapture\Session\TwainHelperChannel.cs</Link>
    </Compile>
    <Compile Include="..\ImagingDeviceManagerTests\FakeTwainDsm.cs;..\ImagingDeviceManagerTests\FakeDsmMemory.cs;..\ImagingDeviceManagerTests\FakeHelperSource.cs">
      <Link>Linked\ImagingDeviceManagerTests\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- Helper32Client, the program's side. -->
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <!-- The helper, built before the tests. The tests start it from the program output's Helper32\ folder, where it has its own x86 runtime
         (Support\HelperCopy.cs, S3b-5): a copy of the self-contained apphost in this folder could not start. -->
    <ProjectReference Include="..\..\OpenPmsDentalHelper32\OpenPmsDentalHelper32.csproj" />
    <!-- The program processes of the tests that end a program (a TestProbeHost child that starts its own helper). -->
    <ProjectReference Include="..\TestProbeHost\TestProbeHost.csproj" />
    <!-- The synthetic Topaz control (S3a-8b), which the Topaz module loads by path as it loads SigPlusNET.dll (S3a-14). -->
    <ProjectReference Include="..\TopazStandIn\TopazStandIn.csproj" />
  </ItemGroup>
</Project>
