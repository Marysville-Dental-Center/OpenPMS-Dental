<Project Sdk="Microsoft.NET.Sdk">
  <!-- The child process of the tests that need a process of their own (S3a-8 of the .NET 10 move, docs/port-notes/S3a-8.md): a fresh process
       in place of the new AppDomain that .NET cannot create (https://learn.microsoft.com/en-us/dotnet/core/porting/net-framework-tech-unavailable).
       TestProbeHost.exe loads a test assembly, calls the Handle method of one of its types for each line its test sends, and answers on
       standard output. ProbeProcess (the client the tests use) copies it under a name of its own into the folder the child process runs
       from, with the config the test gives it. Not a test project: its name does not end with Tests, so the test runner never runs it and
       Directory.Build.targets gives it no shared test config. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TestProbeHost</RootNamespace>
    <AssemblyName>TestProbeHost</AssemblyName>
    <!-- The restore of both runtime identifiers an exe of this framework gets from its platform (TC-10 of the WPF chart plan,
         docs/port-notes/TC-10.md). The SDK gives a .NET Framework exe the runtime identifier of its PlatformTarget (win-x86 from the
         repository's x86, win-x64 in the lane's x64 test build of the test projects that reference this one, S3a-12), and the build needs
         that identifier's target in the assets file (NETSDK1047 without it). The restore, which runs for x86 in both builds, writes both
         targets here; the x86 build still uses win-x86 and its output does not change. -->
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- No test framework: tests\Directory.Build.props gives every project under tests\ the three MSTest 4 packages. -->
    <PackageReference Remove="MSTest.TestFramework" />
    <PackageReference Remove="MSTest.TestAdapter" />
    <PackageReference Remove="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
</Project>
