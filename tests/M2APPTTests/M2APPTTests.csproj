<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-APPT (docs/specs/port-backlog.md): the 25.4 blockout permission split (Blockout Add, Edit and Delete), the
       26.1 preference that lets Make Recall skip the opening search, and the 26.1 move of the default provider for unassigned operatories into
       Preferences. Database tests use a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) with a unique per-run
       name, filled with synthetic rows only, and are skipped (inconclusive) when it does not answer, or when M2APPT_TEST_DB=skip.
       Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
