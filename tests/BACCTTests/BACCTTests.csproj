<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package B-ACCT (Account module and sales tax): the sales-tax procedure (Open Dental 24.4), sales tax rows last within their
       date and sales-tax procedures on claims (25.1), the Daily Payments merchant-fee option (24.4) and the Select Production and Ortho Case window
       text (25.2, 25.3). Database tests use one scratch database on the local MariaDB (127.0.0.1:3306, root, blank password), built from the 24.3.63
       seed and the fork migrations, and are skipped (inconclusive) when it does not answer, or when BACCT_TEST_DB=skip. Synthetic data only.
       Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Its own [AssemblyInitialize] registers the code pages (tests\Shared\TestCodePages.cs; S3b-5). -->
    <ODOwnAssemblyInitialize>true</ODOwnAssemblyInitialize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
