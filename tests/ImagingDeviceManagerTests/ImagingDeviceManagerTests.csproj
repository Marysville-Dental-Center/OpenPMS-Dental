<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for ImagingDeviceManager. They need no scanner: the TWAIN protocol is exercised against a
    simulated Data Source Manager (FakeTwainDsm). MSTest v1, like UnitTestsCore. Run with vstest.console /Platform:x86.
    Every .cs file under this folder is compiled.
  -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\third-party\build\PdfSharp-gdi\PdfSharp-gdi.csproj" />
    <ProjectReference Include="..\..\ImagingDeviceManager\xImagingDeviceManager.csproj" />
  </ItemGroup>
</Project>
