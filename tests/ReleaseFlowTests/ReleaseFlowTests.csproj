<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the version guard, database adoption and the release channel (backlog M1-03, Risk R1; docs/release-process.md).
       Database tests use scratch databases on the local MariaDB (127.0.0.1:3306, root, blank password) with synthetic data only, and are
       inconclusive when no server answers or RELEASEFLOW_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 ahead of the other test projects (S3b-7 of docs/specs/net10-plan.md, docs/port-notes/S3b-7.md): every project it references
         (CodeBase, DataConnectionBase, the business library, TestProbeHost) is .NET 10. It replaces the net48 of tests\Directory.Build.props, so
         Directory.Build.Net.props gives it the settings of a .NET 10 test project: x64, win-x64, framework-dependent, NLS; Mono.Cecil 0.11.6
         (Directory.Packages.props). Windows Forms: the business library's Windows Desktop framework (S3b-3). The line goes when S3b-5 deletes
         the shared net48 line. System.IO.Compression is in the shared framework, so it needs no reference. -->
    <TargetFramework>$(ODTargetFramework)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reads which assemblies of the program folder the Helix load needs, without loading them (S3a-8b of the .NET 10 move). The NuGet
         package, from the offline package folder (nuget.config), at the version of Directory.Packages.props. -->
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
    <!-- The rule for tests that check a built file: inconclusive when it is not built, a failure with OPMS_REQUIRE_BUILD_OUTPUT=1. -->
    <Compile Include="..\ProjectFileTests\BuildOutput.cs">
      <Link>BuildOutput.cs</Link>
    </Compile>
    <!-- The program's managed assembly: OpenPmsDental.dll on .NET (the .exe is the apphost), OpenPmsDental.exe on .NET Framework (S3a-8). -->
    <Compile Include="..\ProjectFileTests\ProgramAssembly.cs">
      <Link>ProgramAssembly.cs</Link>
    </Compile>
    <!-- The packages of a lock file and the files the build copies from them (S2-4 of the .NET 10 move: the release compares each package file
         with its package). -->
    <Compile Include="..\ProjectFileTests\NuGetFiles.cs">
      <Link>NuGetFiles.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- The child process of the Helix load from the program's files and of ProbeProcess's own tests (TestProbeHost, S3a-8b of the .NET 10
         move: .NET has no new AppDomain). -->
    <ProjectReference Include="..\TestProbeHost\TestProbeHost.csproj" />
  </ItemGroup>
</Project>
