<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the native-first chooser (S3a-14n of the .NET 10 move, docs/port-notes/S3a-14.md, section "S3a-14n: native first"):
       CodeBase's NativeFirstChooser and PeImageInfo against synthetic PE files written by the tests (an IL-only AnyCPU DLL, an x86-only DLL,
       64-bit DLLs, native DLLs) and against fake COM activations that fail with each error the chooser catches. A library-only project
       (CodeBase and the framework), so the lane can build it as x64 too and run it as a 64-bit process (odbuild -X64Test): every test checks
       the choice for the bitness it runs at. No vendor DLL is loaded, no COM class is activated, nothing is shown; the synthetic files are
       written to a folder of the test's own under the temporary folder and deleted. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 ahead of the other test projects (S3b-3 of docs/specs/net10-plan.md): it references only CodeBase, net10.0-windows since
         S3b-2. It replaces the net48 of tests\Directory.Build.props, so Directory.Build.Net.props gives it the settings of a .NET 10 test
         project: x64, win-x64, framework-dependent, NLS. The line goes when S3b-5 deletes the shared net48 line. -->
    <TargetFramework>$(ODTargetFramework)</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
  </ItemGroup>
</Project>
