<Project Sdk="Microsoft.NET.Sdk">
  <!-- Image tests of the graphical tooth chart (docs/specs/wpf-tooth-chart-plan.md, track TC). Package TC-0 adds the synthetic chart scenes,
       the recorder of today's DirectX, OpenGL and Simple 2D pictures (retired with those engines in TC-9a; the recordings stay), the image
       comparer and the model tests; package TC-1 adds the WPF chart's mesh, scene, transform, renderer and image tests, its baselines (Baselines/wpf-net48) and the gallery.
       Package TC-2 adds the call-log tests of the chart's painting code, the only tests here with a database: synthetic patients in a scratch
       database on the local MariaDB (Support\ChartTestDb.cs). No program code: the scenes set their state through ToothChartRelay only. The
       project references WpfControlsOD and the libraries below it, never the program. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms and WPF from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\SparksToothChart\SparksToothChart.csproj" />
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
    <!-- The second process (SecondProcess): TestProbeHost runs SecondProcessEntry.Run as its Main (S3a-8b of the .NET 10 move: .NET has no
         run-time C# compiler). -->
    <ProjectReference Include="..\TestProbeHost\TestProbeHost.csproj" />
  </ItemGroup>
</Project>
