<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for package N64-A (docs/port-notes/N64-A.md; items A2 and A4 of docs/specs/native64-survey.md): the plug-in loaders' PE kind and
       target framework check, with synthetic plug-in DLLs (any CPU, x86 only, x64) written by Mono.Cecil; the PE reader against Mono.Cecil;
       Trojan's install key on a fake registry seam; Word's registration errors and the x64 build's Word code; no D3DX loaded (the D3DX log line
       went with the DirectX chart in TC-9a). Library-only
       (no program exe), so the lane's x64 test build runs it too (-X64Test). No test starts Word, loads a third-party plug-in, opens a real
       registry key or shows a window. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 ahead of the other test projects (S3b-4 of docs/specs/net10-plan.md): every project it references is net10.0-windows since
         S3b-4 (WpfControlsOD), and it holds the plug-in test of the plan's section 7 (PluginDecision16Tests). It replaces the net48 of
         tests\Directory.Build.props, so Directory.Build.Net.props gives it the settings of a .NET 10 test project: x64, win-x64,
         framework-dependent, NLS; Mono.Cecil 0.11.6 (Directory.Packages.props). Windows Forms for its System.Windows.Forms use. The line goes
         when S3b-5 deletes the shared net48 line. -->
    <TargetFramework>$(ODTargetFramework)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <!-- Writes the synthetic plug-in DLLs and reads assemblies without loading them, to check CodeBase.PortableExecutableFile. The NuGet package,
         from the offline package folder (nuget.config), at the version of Directory.Packages.props. -->
    <PackageReference Include="Mono.Cecil" />
    <!-- The rule for tests that check a built file (PluginDecision16Tests: the rebuilt PluginExample): inconclusive when it is not built, a
         failure with OPMS_REQUIRE_BUILD_OUTPUT=1. -->
    <Compile Include="..\ProjectFileTests\BuildOutput.cs">
      <Link>BuildOutput.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- Trojan's install key lookup (Bridges\Trojan.cs). -->
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
    <!-- No D3DX loaded by a chart that starts and draws (ToothChartWrapper; TC-9a retired the DirectX chart and its D3DX log line). -->
    <ProjectReference Include="..\..\SparksToothChart\SparksToothChart.csproj" />
  </ItemGroup>
</Project>
