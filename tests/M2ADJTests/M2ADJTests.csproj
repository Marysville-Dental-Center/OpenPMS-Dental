<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for percent-of-fee adjustments (package M2-ADJ in docs/specs/port-backlog.md): the Percent of Fee calculation shared by Edit
       Adjustment and Add Multiple Adjustments, percentage entry and display, and the default percentage of an adjustment type stored in
       definition.Supp. Database tests use scratch MariaDB databases with unique names and synthetic rows only. Every .cs file under this folder
       is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
