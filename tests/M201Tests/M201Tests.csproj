<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-01: the Open Dental 25.3.48 to 26.1.70 schema steps, the 26.1.70 reference schema, the regenerated CRUD and the
       enum values that live in the changed table classes. Database tests use scratch databases on the local MariaDB (127.0.0.1:3306, root, blank
       password) with names unique to the run, dropped afterwards, and are skipped (inconclusive) when it does not answer or when M201_TEST_DB=skip.
       Synthetic data only. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
