<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for package S1-T of the .NET 10 plan (docs/specs/net10-plan.md): the shared reader of project files that the tests which check
       project files use, so their checks hold for today's classic project files and for the SDK-style ones of stage 1 alike, and the rule for
       tests that need a built file (OPMS_REQUIRE_BUILD_OUTPUT). The fixture projects under Fixtures\ are copied to a scratch folder in the temp
       folder for each test and deleted afterwards. No database, no build, no program is started. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reads the references of the MSTest adapter's assemblies and writes the synthetic assemblies of NuGetFilesTests without loading or
         emitting through the runtime (S3a-8b of the .NET 10 move: .NET has no reflection-only load and cannot save a dynamic assembly). The
         NuGet package, from the offline package folder (nuget.config), at the version of Directory.Packages.props. -->
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>
</Project>
