<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for accounting transactions at Open Dental 25.3 parity: Payee, Notes, Needs Review and the next check number (backlog package A-ACCT).
       Database tests use scratch databases on the local MariaDB (127.0.0.1:3306, root, blank password), built from the embedded Open Dental 25.3.48
       reference schema and filled with synthetic rows only. They are skipped (inconclusive) when the server does not answer, or when
       ACCOUNTING_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
