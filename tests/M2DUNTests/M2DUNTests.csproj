<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for HTML dunning and billing e-mails (package M2-DUN in docs/specs/port-backlog.md, item v26_1-manage-dunning-html): statement
       e-mails whose dunning override or Billing Defaults body is plain text, HTML or raw HTML. Database tests use a scratch MariaDB database
       with a unique per-run name (127.0.0.1:3306, root, blank password), built from the 24.3.63 seed and the fork migrations, and are skipped
       (inconclusive) when it does not answer, or when M2DUN_TEST_DB=skip. Synthetic data only. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
