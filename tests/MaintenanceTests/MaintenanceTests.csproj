<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for routine maintenance (docs/specs/routine-maintenance.md): schedule math, due/overdue/lead-time status, result-field validation
       and limits, the fork-only enum values, CRUD round trips and the migration steps on a scratch database, and alert creation without
       duplicates. Database tests use scratch MariaDB databases named test_maint_* with synthetic rows only. Every .cs file under this folder is
       compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
