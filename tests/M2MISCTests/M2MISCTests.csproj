<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for package M2-MISC in docs/specs/port-backlog.md (small Open Dental 25.4 and 26.1 items): the local Diagnostics text, the printer
       rules and printer states of Setup, Printers, the referral phone width, the "procedure clinic differs from patient clinic" automation
       condition, the non-modal task attachment windows and the Perio Chart's Current Direction buttons. Database tests use scratch MariaDB
       databases with unique names and synthetic rows only. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- .NET 10 (S3b-5 of docs/specs/net10-plan.md): Windows Forms and WPF from the Windows Desktop framework, in place of the
         .NET Framework assembly references; it also keeps the Windows Desktop packages out of the restore (S3b-3). -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- The Perio Chart grid (ContrPerio), the task attachment windows and the About box live in OpenPmsDental.exe; cell positions (ColRow) in
         WpfControlsOD. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
