<Project>
  <!--
    Shared settings, imported by every project in this repository: Microsoft.Common.props imports this file for the
    classic C# projects, the SDK-style ones and Direct2dWrapper.vcxproj alike.

    Everything in it is for SDK-style projects only. Microsoft.NET.Sdk sets UsingMicrosoftNETSdk before it imports
    this file; the classic projects, the classic Middle Tier project (OpenPmsDentalServer) and Direct2dWrapper.vcxproj
    never set it, so they build exactly as before. Stage 1 of the .NET 10 move (docs/specs/net10-plan.md, section 2.3)
    converts the C# projects to SDK-style one by one; with these settings they keep today's output folders and files.

    Stage 3b (package S3b-1, docs/port-notes/S3b-1.md): the SDK-style projects target .NET 10 for Windows, 64-bit. The target
    framework is set here, once; a project that still names net48 itself (the test projects through tests\Directory.Build.props
    until S3b-5, NoHqTests, the third-party source builds through third-party\build\SourceBuild.props until S3b-2) stays a .NET
    Framework 4.8 x86 project with the settings below, exactly as on main. What only a .NET 10 project gets (x64, the runtime
    identifier, self-contained exes, NLS, the platform attributes, WFDEV006 as an error) is in Directory.Build.Net.props, which
    the SDK imports right after the project's own properties (BeforeMicrosoftNETSdkTargets, below), where the project's target
    framework, output type and name are known.
  -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <!--
      The target framework of the .NET build (decision 19 of the plan: net10.0-windows, x64), for every SDK-style project that names
      none itself. ODTargetFramework is the one name Directory.Build.Net.props compares a project's TargetFramework with.
    -->
    <ODTargetFramework>net10.0-windows</ODTargetFramework>
    <TargetFramework>$(ODTargetFramework)</TargetFramework>
    <!--
      Directory.Build.Net.props, imported by Sdk.targets of Microsoft.NET.Sdk (line 13 in SDK 10.0.115) after the project's own
      properties and before every file of the SDK's targets (the target framework inference, the runtime identifier inference, the
      output paths, the restore's view of the project): the one point where a setting can depend on the project's TargetFramework and
      OutputType and still be seen by everything the SDK computes from it. A project that names its own file keeps it.
    -->
    <BeforeMicrosoftNETSdkTargets Condition="'$(BeforeMicrosoftNETSdkTargets)' == ''">$(MSBuildThisFileDirectory)Directory.Build.Net.props</BeforeMicrosoftNETSdkTargets>
    <!--
      One flat output folder per configuration, as today: bin\Debug\ and bin\Release\, without a net48\ or win-x86\
      sub folder, and without the platform folder the SDK adds for any platform other than AnyCPU (bin\x86\Debug\).
      The SDK then computes OutputPath as bin\$(Configuration)\ after the project's own properties, when
      $(Configuration) is known (Microsoft.NET.DefaultOutputPaths.targets), so the path is right even for a project
      built on its own without a configuration.
    -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <!--
      AssemblyInfo.cs and SharedAssemblyInfo.cs stay the only source of the assembly attributes and versions (a .NET 10 project lets
      the SDK write its two platform attributes only, Directory.Build.Net.props).
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- x86 for a .NET Framework 4.8 project; a .NET 10 project is x64 (Directory.Build.Net.props). -->
    <PlatformTarget>x86</PlatformTarget>
    <!--
      Only the English resources of packages; no language folders in the output. For a self-contained .NET 10 exe it also keeps the
      13 language folders of the WindowsDesktop runtime pack out (the SDK's ResolveRuntimePackAssets filters by it), so the output stays
      flat.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Every restore writes packages.lock.json; the build lane restores in locked mode, so a change is an error. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <!--
      The SDK writes a supportedRuntime element into a .NET Framework exe's app.config and saves the file again (other
      XML declaration and indentation) unless this is off; with it off, every exe's .config stays byte for byte as today.
    -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <!-- No Source Link: the PDBs record no repository URL or commit, and the build does not read the .git folder. -->
    <EnableSourceLink>false</EnableSourceLink>
    <!--
      For UseWPF projects (WpfControlsOD, ImagingCapture since S1-4): the SDK builds the pages with its own WPF build targets instead of
      the .NET Framework's, and for those it embeds the generated sources (obj\**\*.g.cs) in the PDB unless this is off; off, as for the
      classic projects, so the PDB holds no source text. Its markup compiler also writes a SHA-1 checksum of each .xaml file into the
      generated .g.cs (#pragma checksum, kept in the PDB) unless told otherwise; the .NET Framework's wrote SHA-256, the compiler's own
      default for the .cs files, so SHA-256 it stays. Both are the compiler's defaults for projects without pages.
    -->
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <ChecksumAlgorithm>SHA256</ChecksumAlgorithm>
    <!--
      AutoGenerateBindingRedirects is not set here: binding redirects mean nothing on .NET (S3b-1 removed it from the projects that
      named it). A .NET Framework project that leaves it empty gets it on, as before: the SDK turns it on for every .NET Framework exe
      and test project (Microsoft.NET.Sdk.BeforeCommon.targets), and MSBuild's common targets for every project that targets .NET
      Framework 4.7.2 or later (Microsoft.Common.CurrentVersion.targets).
    -->
  </PropertyGroup>
</Project>
