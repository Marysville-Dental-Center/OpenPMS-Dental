<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DevDbTool: builds a local development database for this codebase from the seed dump in
    UnitTests\Resources\dump.txt, then upgrades it with the convert scripts in OpenPmsDentalBusiness.
    Run it through tools\New-DevDatabase.ps1, which builds it on its own. With export-init-sql it also writes
    db\init\new-database.sql, the SQL file that initializes a new database (tools\New-InitSql.ps1). It is in OpenDental.sln
    and OpenDental.Local.slnf, so that every solution build compiles it, catches a break early and builds it for the test
    that regenerates that file (tests\ForkMigrationTests\InitSqlRegenerationTests.cs).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DevDbTool</RootNamespace>
    <AssemblyName>DevDbTool</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Platforms>x86</Platforms>
    <!-- net10.0-windows x64, a self-contained win-x64 exe, from Directory.Build.props and Directory.Build.Net.props (stage 3b, S3b-3 of
         docs/specs/net10-plan.md): it moves with the business library it references. A console program; the .NET Framework references
         below went (part of .NET 10's shared framework). -->
    <!-- The Windows Desktop framework, which the business library uses (Windows Forms, WPF, System.DirectoryServices, ...), named here as well:
         NuGet leaves out of the restore the packages a project's own frameworks hold (package pruning), and without it the restore asks for
         System.DirectoryServices, System.Configuration.ConfigurationManager and System.Security.Cryptography.Pkcs as packages
         (System.DirectoryServices.AccountManagement's dependencies), which the offline folder does not have and the program never ships. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ODCrypt\xODCrypt.csproj" />
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
