<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AdoptionValidation: the M1-Z switch-gate rehearsal (docs/specs/port-backlog.md, section M1-Z). It generates a synthetic Open Dental
    25.3.48 database with tools\SyntheticData, records its validation baseline, backs it up and restores a copy, adopts the copy with the
    business layer's adoption tool (M1-03), runs the fork migration and the schema verifier (M1-01), and validates the result:
    row counts, checksums, business totals, a load-and-save round trip of every 24.4-25.3 column through OpenPmsDentalBusiness, the version
    sentinels and an Open Dental-style startup check. Synthetic data on the local server only. See README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdoptionValidation</RootNamespace>
    <AssemblyName>AdoptionValidation</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Platforms>x86</Platforms>
    <!-- Every source file under this folder except the test project (its own project, in the sub folder) and build output. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);AdoptionValidation.Tests\**</DefaultItemExcludes>
    <!-- net10.0-windows x64, a self-contained win-x64 exe, from Directory.Build.props and Directory.Build.Net.props (stage 3b, S3b-3 of
         docs/specs/net10-plan.md): it moves with the business library it references. A console program; its .NET Framework references went
         (part of .NET 10's shared framework). -->
    <!-- The Windows Desktop framework, which the business library uses (Windows Forms, WPF, System.DirectoryServices, ...), named here as well:
         NuGet leaves out of the restore the packages a project's own frameworks hold (package pruning), and without it the restore asks for
         System.DirectoryServices, System.Configuration.ConfigurationManager and System.Security.Cryptography.Pkcs as packages
         (System.DirectoryServices.AccountManagement's dependencies), which the offline folder does not have and the program never ships. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
    <!-- Newtonsoft.Json, the version of Directory.Packages.props. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Runbook step 0.6: copied next to the program, so the folder copied to the database server (<tools> in the runbook) has it. -->
    <None Update="Invoke-RunbookDryRun.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SyntheticData\SyntheticData.csproj" />
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
