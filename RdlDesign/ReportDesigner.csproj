<Project Sdk="Microsoft.NET.Sdk">
  <!--
    fyiReporting RDL Project 2.9.3 report designer (RdlDesigner.exe), against the engine and viewer built from RdlEngine\ and RdlViewer\. A
    developer tool: in the solution so every build compiles it, not shipped (decision 17 of docs/specs/net10-plan.md). Every .cs and .resx file in
    this folder is compiled.
    2026-11-16: .NET 10, x64 (package S3b-2b, docs/port-notes/S3b-2.md part B): the repository's target framework and its .NET settings
    (Directory.Build.Net.props: a self-contained win-x64 exe), with the Windows Forms framework; its <Code> syntax check compiles with
    RdlEngine's Roslyn compile (decision 14).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>fyiReporting.RdlDesign</RootNamespace>
    <AssemblyName>RdlDesigner</AssemblyName>
    <StartupObject>fyiReporting.RdlDesign.RdlDesigner</StartupObject>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <BaseAddress>285212672</BaseAddress>
    <FileAlignment>4096</FileAlignment>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <!-- No symbols and no warnings in a Release build. -->
    <DebugType>none</DebugType>
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- Each window's or control's .resx belongs to the .cs file of the same name, which gives it its class-based resource name. -->
    <EmbeddedResource Update="*.resx" DependentUpon="%(Filename).cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RdlEngine\RdlEngine.csproj" />
    <ProjectReference Include="..\RdlViewer\RdlViewer.csproj" />
  </ItemGroup>
  <!--
    Doubles and floats written as text as .NET Framework wrote them (package S3b-FMT of the .NET 10 move, decision 24 of
    docs/specs/net10-plan.md, docs/port-notes/S3b-FMT.md): CodeBase's ODNumberText.ToStringNetFx and AsNetFx, compiled in as an internal
    class (OD_NUMBERTEXT_LINKED), since this project does not reference CodeBase.
  -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);OD_NUMBERTEXT_LINKED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\CodeBase\Utilities\ODNumberTextNetFx.cs">
      <Link>Utilities\ODNumberTextNetFx.cs</Link>
    </Compile>
  </ItemGroup>
  <!--
    The UI refresh's token renderer for the designer's stock menus, status strip and context menus (package UI-6, docs/port-notes/UI-6.md;
    docs/specs/ui-refresh-plan.md section 3.6): the WinForms part of CodeBase's UiTheme (colours, per-thread brushes, sizes, fonts, the
    renderer) and the icon renderer for its glyphs, compiled in as linked files, since this project does not reference CodeBase. They use only
    Windows Forms, System.Drawing and Microsoft.Win32 (NoHqTests' UiThemeScanTests checks it). Main calls CodeBase.UiTheme.InitWinForms().
  -->
  <ItemGroup>
    <Compile Include="..\CodeBase\UI\UiTheme.cs">
      <Link>CodeBase\UI\UiTheme.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiTheme.Colors.cs">
      <Link>CodeBase\UI\UiTheme.Colors.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiTheme.Gdi.cs">
      <Link>CodeBase\UI\UiTheme.Gdi.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiTheme.Metrics.cs">
      <Link>CodeBase\UI\UiTheme.Metrics.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiTheme.Fonts.cs">
      <Link>CodeBase\UI\UiTheme.Fonts.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiTheme.Renderer.cs">
      <Link>CodeBase\UI\UiTheme.Renderer.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\Icons\UiIcons.cs">
      <Link>CodeBase\UI\Icons\UiIcons.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\Icons\UiIcons.Gdi.cs">
      <Link>CodeBase\UI\Icons\UiIcons.Gdi.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\Icons\IconData.g.cs">
      <Link>CodeBase\UI\Icons\IconData.g.cs</Link>
    </Compile>
  </ItemGroup>
  <!--
    UI-PLAIN-2 (docs/port-notes/UI-PLAIN.md section 8): the designer's windows and dialogs call CodeBase.UiPlainWindow.Attach, the look and
    the title bar of the program's windows (the window background token, the inputs' frame, the program's buttons, check boxes, radio
    buttons, group boxes, tabs and scroll bars, the frame FormODBase draws): the shared looks, the painters they draw with and the frame are
    linked files too, as UpdateFileCopier links them.
  -->
  <ItemGroup>
    <Compile Include="..\CodeBase\UI\UiControlPaint.cs">
      <Link>CodeBase\UI\UiControlPaint.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiScrollPaint.cs">
      <Link>CodeBase\UI\UiScrollPaint.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiSliderPaint.cs">
      <Link>CodeBase\UI\UiSliderPaint.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiListPaint.cs">
      <Link>CodeBase\UI\UiListPaint.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiInputFrame.cs">
      <Link>CodeBase\UI\UiInputFrame.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiLooks.cs">
      <Link>CodeBase\UI\UiLooks.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiRadioLook.cs">
      <Link>CodeBase\UI\UiRadioLook.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiScrollLook.cs">
      <Link>CodeBase\UI\UiScrollLook.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiTrackBarLook.cs">
      <Link>CodeBase\UI\UiTrackBarLook.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiUpDownLook.cs">
      <Link>CodeBase\UI\UiUpDownLook.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiTabPaint.cs">
      <Link>CodeBase\UI\UiTabPaint.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiTabLook.cs">
      <Link>CodeBase\UI\UiTabLook.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiPlainWindow.cs">
      <Link>CodeBase\UI\UiPlainWindow.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiFramePainter.cs">
      <Link>CodeBase\UI\UiFramePainter.cs</Link>
    </Compile>
    <Compile Include="..\CodeBase\UI\UiPlainFrame.cs">
      <Link>CodeBase\UI\UiPlainFrame.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
