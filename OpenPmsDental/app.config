<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="OpenPmsDental.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <applicationSettings>
        <OpenPmsDental.Properties.Settings>
            <setting name="OpenDental_CallFireService_SMSService" serializeAs="String">
                <value>https://www.callfire.com/service/SMSService</value>
            </setting>
            <setting name="OpenDental_NewCrop_Update1" serializeAs="String">
                <value>https://secure.newcropaccounts.com/v7/WebServices/Update1.asmx</value>
            </setting>
            <setting name="OpenDental_EmdeonITS_ITSWS" serializeAs="String">
                <value>https://its.changehealthcare.com/ITS/ITSWS.asmx</value>
            </setting>
        </OpenPmsDental.Properties.Settings>
    </applicationSettings>
    <!--
      On .NET 10 (S3b-4 of docs/specs/net10-plan.md, docs/port-notes/S3b-4.md) the program reads this file as OpenPmsDental.dll.config, and only
      the applicationSettings above (Properties.Settings, through System.Configuration.ConfigurationManager of the Windows Desktop runtime). The
      sections that only the .NET Framework read went:
      - runtime (the binding redirects): .NET resolves assembly versions without them;
      - startup (supportedRuntime and useLegacyV2RuntimeActivationPolicy): the program carries its own runtime (decision 20), and every
        managed DLL in "Required dlls" is IL-only, so nothing needs the legacy activation policy;
      - System.Windows.Forms.ApplicationConfigurationSection (DpiAwareness PerMonitorV2): ProgramEntry.Main calls
        Application.SetHighDpiMode(HighDpiMode.PerMonitorV2) instead;
      - system.net (httpWebRequest useUnsafeHeaderParsing, for DentalXChange): .NET has no such setting, and the DentalXChange answers parse
        without it (S3b-0 item 6);
      - system.serviceModel (Divvy postcards' WCF endpoint and binding): .NET has no WCF client; the endpoint and binding are recorded in
        WpfControlsOD\Bridges\DivvyPostcardService.cs for its port (open point O-10).
    -->
</configuration>
