  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <!-- Each configuration has its own output folder. With one bin\ for all of them, an incremental Release build after a Debug build found
       the Debug DLL newer than its inputs, skipped the link, and the post-build step copied the Debug DLL (which needs the debug C runtime,
       not redistributable) into OpenPmsDental\bin\Release. tools\Build-Release.ps1 compares the staged DLL with bin\Release. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <TargetName>Direct2dWrapper</TargetName>
    <LinkIncremental>true</LinkIncremental>
    <OutDir>$(ProjectDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetName>Direct2dWrapper</TargetName>
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(ProjectDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <!-- x64 only (stage 3b of docs/specs/net10-plan.md, S3b-4; docs/port-notes/S3b-4.md): the program is 64-bit (decision 19), and the Win32
       configurations went, since no build uses them after the switch. Each configuration builds into bin\x64\$(Configuration)\ (Build-Release
       takes the Release DLL from there) and copies the DLL into the program's output folder of the same configuration, beside
       OpenPmsDental.exe, as the Win32 configurations did for the 32-bit program. The pointer-truncation warnings C4311 and C4312 are errors
       (docs/port-notes/S3a-16.md). The project keeps the v143 toolset. -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>WIN32;_DEBUG;DIRECT2DWRAPPER_EXPORTS;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <TreatSpecificWarningsAsErrors>4311;4312;%(TreatSpecificWarningsAsErrors)</TreatSpecificWarningsAsErrors>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
      <AdditionalDependencies>d2d1.lib;dwrite.lib;D3D11.lib;dxguid.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>xcopy "$(TargetDir)Direct2dWrapper.dll" "..\OpenPmsDental\bin\Debug\" /Y</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>WIN32;NDEBUG;DIRECT2DWRAPPER_EXPORTS;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <TreatSpecificWarningsAsErrors>4311;4312;%(TreatSpecificWarningsAsErrors)</TreatSpecificWarningsAsErrors>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
      <AdditionalDependencies>d2d1.lib;dwrite.lib;D3D11.lib;dxguid.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>xcopy "$(TargetDir)Direct2dWrapper.dll" "..\OpenPmsDental\bin\Release\" /Y</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="D2DWrapperHwnd.h" />
    <ClInclude Include="framework.h" />
    <ClInclude Include="Direct2dWrapper.h" />
    <ClInclude Include="pch.h" />
