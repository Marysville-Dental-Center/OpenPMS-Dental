<Project Sdk="Microsoft.NET.Sdk">
  <!--
    PluginExample.dll: the example of a plug-in for the program (a program link's PluginDllName; WpfControlsOD\Bridges\PluginLoader.cs and
    OpenPmsDentalBusiness\Plugins\Plugins.cs load it, as [file name].Plugin, a PluginBase). Not shipped (it is in none of
    tools\Build-Release.ps1's lists); the lane builds it with the solution, so it keeps compiling against the program.
    An SDK-style net10.0-windows x64 library since S3b-4 of docs/specs/net10-plan.md (decision 16; docs/port-notes/S3b-4.md): plug-ins built
    for the .NET Framework are not supported by the .NET 10 program, which refuses them with a clear message without loading them, and this
    example is the one rebuilt for .NET (x64 from Directory.Build.Net.props; a plug-in for any CPU loads too). It was a classic .NET
    Framework 4.7.2 project outside the solution filter until then. The SDK's default globs compile every .cs file and embed every .resx
    file under this folder (bin\ and obj\ excepted); only items with their own metadata are listed. Its own PluginExample.sln stays for a
    plug-in developer who opens the example alone.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Windows Forms: its controls and forms. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PluginExample</RootNamespace>
    <AssemblyName>PluginExample</AssemblyName>
    <!-- The language version of the classic project (the default of the .NET Framework 4.7.2 build). -->
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="ContrAccountP.Designer.cs">
      <DependentUpon>ContrAccountP.cs</DependentUpon>
    </Compile>
    <Compile Update="ContrChartP.Designer.cs">
      <DependentUpon>ContrChartP.cs</DependentUpon>
    </Compile>
    <Compile Update="FormFromToolbar.Designer.cs">
      <DependentUpon>FormFromToolbar.cs</DependentUpon>
    </Compile>
    <Compile Update="FormPatientEditP.Designer.cs">
      <DependentUpon>FormPatientEditP.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="ContrAccountP.resx">
      <DependentUpon>ContrAccountP.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ContrChartP.resx">
      <DependentUpon>ContrChartP.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormFromToolbar.resx">
      <DependentUpon>FormFromToolbar.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormPatientEditP.resx">
      <DependentUpon>FormPatientEditP.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\third-party\build\MigraDoc.DocumentObjectModel\MigraDoc.DocumentObjectModel.csproj" />
    <ProjectReference Include="..\third-party\build\MigraDoc.Rendering-gdi\MigraDoc.Rendering-gdi.csproj" />
    <ProjectReference Include="..\third-party\build\PdfSharp-gdi\PdfSharp-gdi.csproj" />
    <ProjectReference Include="..\third-party\build\PdfSharp.Charting-gdi\PdfSharp.Charting-gdi.csproj" />
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
  <!--
    As in the classic project's post-build event: in a Debug build, CopyDllToOD.bat copies bin\Debug\PluginExample.dll into
    OpenPmsDental\bin\Debug\, where the program's loader finds a plug-in by its file name.
  -->
  <Target Name="PluginExampleCopyToProgram" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="set ENV_ProjectDir=$(ProjectDir)&#xD;&#xA;call &quot;$(ProjectDir)CopyDllToOD.bat&quot;" />
  </Target>
</Project>
