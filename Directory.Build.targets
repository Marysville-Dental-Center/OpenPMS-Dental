<Project>
  <!--
    Local build support, imported by every project in this repository, classic and SDK-style alike, after the project's
    own properties. The settings that SDK-style projects need before their own properties (output layout, assembly info,
    platform, lock files) are in Directory.Build.props, for SDK-style projects only.

    Every project the solution builds now exists in this repository, so nothing is
    swapped for a prebuilt DLL any more. The target that replaced a missing
    ProjectReference with the matching DLL in "Required dlls" was removed once
    ImagingDeviceManager, the last such project, came into the repository: a missing
    project now fails the build instead of quietly using an old binary.
  -->

  <!--
    The test projects use MSTest 4 from its packages (S4-1 of the .NET 10 move, docs/port-notes/S4-1.md); nothing references MSTest v1
    from the Visual Studio folder any more, so the folder is no longer added to the search path.

    No test run sends telemetry. MSTest.TestAdapter 4.5.3 depends on Microsoft.Testing.Extensions.Telemetry, which brings
    Microsoft.ApplicationInsights; both serve the Microsoft Testing Platform only, which the test projects never use (they run under
    VSTest, tests\Directory.Build.props). Under VSTest the MSTest adapter has no telemetry sender (MSTestDiscoverer and MSTestExecutor
    pass none) and does not reference either assembly, and vstest.console sends none unless VSTEST_TELEMETRY_OPTEDIN=1. The extension's
    registration for a platform entry point (TestingPlatformBuilderHook 98058041-...) and both packages' assemblies are taken out of every
    project, so no test output folder holds telemetry code at all (tests\ProjectFileTests, TestTelemetryTests, checks it).
  -->
  <ItemGroup>
    <TestingPlatformBuilderHook Remove="98058041-B5B6-4A75-9834-58E6DF796A22" />
  </ItemGroup>
  <!--
    The levels of the MSTest.Analyzers rules (tests\MSTest.globalconfig) for every project that has the analyzers: MSTest.Analyzers.props
    sets MSTestAnalysisMode for them. Like the package's own file, an EditorConfigFiles item, which reaches the compiler after restore.
  -->
  <ItemGroup Condition="'$(MSTestAnalysisMode)' != ''">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)tests\MSTest.globalconfig" />
  </ItemGroup>
  <Target Name="ODRemoveTestTelemetryAssemblies" AfterTargets="ResolvePackageAssets" Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <ItemGroup>
      <_ODTelemetryCompile Include="@(ResolvedCompileFileDefinitions)" Condition="'%(ResolvedCompileFileDefinitions.NuGetPackageId)' == 'Microsoft.Testing.Extensions.Telemetry' or '%(ResolvedCompileFileDefinitions.NuGetPackageId)' == 'Microsoft.ApplicationInsights'" />
      <ResolvedCompileFileDefinitions Remove="@(_ODTelemetryCompile)" />
      <_ODTelemetryRuntime Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Microsoft.Testing.Extensions.Telemetry' or '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Microsoft.ApplicationInsights'" />
      <RuntimeCopyLocalItems Remove="@(_ODTelemetryRuntime)" />
    </ItemGroup>
  </Target>

  <!--
    Stage 3b (S3b-1, docs/port-notes/S3b-1.md) removed two .NET Framework settings that mean nothing on .NET: the default app.config of
    the test projects (tests\BindingRedirects.config, the programs' binding redirects, for a test project without an app.config of its own)
    and the target that dropped the build's suggested System.ValueTuple binding redirect. The test projects that still target .NET
    Framework 4.8 until S3b-5 generate their binding redirects from reference resolution alone (tests\Directory.Build.props).
  -->

  <!--
    The native WebView2Loader.dll of the WebView2 package (Microsoft.Web.WebView2 1.0.2420.47, S2-3 of the .NET 10 move), next to the
    program. Microsoft.Web.WebView2.Core.dll loads it for every WebView2 window; the program, and the test projects that open such
    windows, have always kept it at the top of their output folders, and no package property puts it there: the package's
    build\Common.targets copies it for a managed project as a Content item to runtimes\win-x86\native\ (with EffectivePlatform x86, from
    PlatformTarget x86 of Directory.Build.props, only the x86 one; the x64 and arm64 loaders only for AnyCPU), and
    WebView2LoaderPreference decides only for a native (C++) project. The package's
    targets set WebView2ProjectKind and NugetRoot (its folder); this gives that Content item the file name as its Link, so it lands at the
    top of the output folder and no runtimes folder is written (tools\Build-Release.ps1 refuses a sub folder in the program's output). As a
    Content item that is copied, it also goes to the output of every project that references one with the package's build files, as the
    None item of "Required dlls\WebView2Loader.dll" in OpenPmsDental.csproj did before. The libraries reference the package without its
    build files (ExcludeAssets="build"), so only the program and the test projects that name the package get it, and those that reference
    them. For an exe NuGet also copies the package's native asset of its win-x86 target (runtimes\win-x86\native\WebView2Loader.dll) to the
    same place: the same file.
  -->
  <ItemGroup Condition="'$(WebView2ProjectKind)' == 'managed' and '$(NugetRoot)' != ''">
    <Content Update="$(NugetRoot)runtimes\win-x86\native\WebView2Loader.dll" Link="WebView2Loader.dll" />
  </ItemGroup>

  <!--
    CommunityToolkit.Mvvm 8.3.2, which Helix Toolkit brings to SparksToothChart and every project that references it (TC-4,
    docs/port-notes/TC-4.md), has two Roslyn analyzers in its package: its source generators (CommunityToolkit.Mvvm.SourceGenerators.dll) and
    its code fixes (CommunityToolkit.Mvvm.CodeFixers.dll). The restore hands them to the compiler of every such project, although Helix's
    package asks to leave them out (exclude="Build,Analyzers"), and the package has no switch of its own to turn them off, as
    Microsoft.Extensions.Logging.Abstractions and System.Text.Json have (Directory.Packages.props). Nothing here uses the toolkit's
    generators, so they are removed after the SDK adds the package analyzers (ResolveLockFileAnalyzers, part of
    ResolvePackageDependenciesForBuild; ResolveNuGetPackageAssets in a classic project), as those packages' own targets remove theirs.
    ODRecordCompilerAnalyzers writes the analyzers each SDK-style compilation gets to obj\<configuration>\$(MSBuildProjectName).analyzers.txt
    (package id and file name, one per line), so tests\ReleaseFlowTests (HelixPackageTests) can check from the build's output that none of
    them reaches the compiler.
  -->
  <Target Name="ODRemoveCommunityToolkitMvvmAnalyzers" AfterTargets="ResolvePackageDependenciesForBuild;ResolveNuGetPackageAssets">
    <ItemGroup>
      <_ODCommunityToolkitMvvmAnalyzer Include="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'CommunityToolkit.Mvvm'" />
      <Analyzer Remove="@(_ODCommunityToolkitMvvmAnalyzer)" />
    </ItemGroup>
  </Target>

  <Target Name="ODRecordCompilerAnalyzers" BeforeTargets="CoreCompile" Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <WriteLinesToFile File="$(IntermediateOutputPath)$(MSBuildProjectName).analyzers.txt" Lines="@(Analyzer->'%(NuGetPackageId)|%(Filename)%(Extension)')"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)$(MSBuildProjectName).analyzers.txt" />
    </ItemGroup>
  </Target>

</Project>
