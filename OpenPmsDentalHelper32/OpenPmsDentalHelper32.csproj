<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The 32-bit helper program (S3a-13 of the .NET 10 move, docs/specs/net10-plan.md; docs/port-notes/S3a-13.md). It runs the vendor code that
    exists only as 32-bit code (QuickBooks Desktop's QBFC, S3a-13; Schick CDR, Topaz and Guru, S3a-14; Mediadent / CADI as the fallback,
    N64-A3) for the program, which is 64-bit after stage 3b. The program starts it from the sub folder Helper32\ of its own folder on first use
    (CodeBase\Utilities\Helper32Client.cs), one helper per program process, and talks to it over a named pipe that only the current user may
    open (Helper32Protocol.cs, linked into CodeBase). It has no main window (only Topaz's signing window).

    It references no other project of this repository, so it can have another runtime than the program: net10.0-windows x86, self-contained
    for win-x86 with its own x86 runtime (S3b-4; open point O-15, decision 20; PlatformTarget, RuntimeIdentifier and SelfContained come from
    Directory.Build.Net.props). Its output folder is flat, and OpenPmsDental.csproj (CopyHelper32) copies it whole into the program's
    Helper32\. Its platform stays x86 in every configuration (tools\Build-Release.ps1 checks the PE machine 0x14C). It has no app.config: the
    one it had held only the .NET Framework's startup section. Every .cs file under this folder is compiled.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows Forms: Topaz's signing window and the control it holds (Topaz\). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OpenPmsDentalHelper32</RootNamespace>
    <AssemblyName>OpenPmsDentalHelper32</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\branding\app.ico</ApplicationIcon>
    <LangVersion>8.0</LangVersion>
    <Platforms>x86</Platforms>
    <!-- 32-bit in every configuration: the vendor code it loads is 32-bit only. -->
    <PlatformTarget>x86</PlatformTarget>
    <!-- Guru\GuruModule.cs builds MedVisorInterface.dll's structure with the unsafe code Guru.cs had (S3a-14). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!--
      QuickBooks Desktop's QBFC 10 interop (Intuit's type library QBFC10Lib, "Required dlls"), with its types embedded as the program had them
      before S3a-13, so Interop.QBFC10.dll is never shipped (tools\Build-Release.ps1 denies Interop.*.dll): QuickBooks' own QBFC installation
      registers the COM classes on the workstation. Besides the helper's tests, only WpfControlsOD references it, embedded too, for the program's
      in-process path of S3a-14n (native first; this module is the fallback); tests\NoHqTests, Helper32VendorScanTests.
    -->
    <Reference Include="Interop.QBFC10">
      <HintPath>..\Required dlls\Interop.QBFC10.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <!--
      Schick CDR DICOM's automation interop (type libraries CDRDicom and CDRDATALib, "Required dlls"), embedded as the program embedded them
      before S3a-14, so neither file is shipped: CDR's own installation registers its COM classes. Used by Schick\SchickModule.cs only.
    -->
    <Reference Include="Interop.CDRDATALib">
      <HintPath>..\Required dlls\Interop.CDRDATALib.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.CDRDicom">
      <HintPath>..\Required dlls\Interop.CDRDicom.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <!-- The C# runtime binder (Microsoft.CSharp, for Cadi\CadiModule.cs's late-bound calls to CADI's automation object), System.Drawing and
         Windows Forms (Topaz's control, drawn into a picture and shown in the signing window) are parts of Microsoft.NETCore.App and
         Microsoft.WindowsDesktop.App on .NET (UseWindowsForms). -->
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
