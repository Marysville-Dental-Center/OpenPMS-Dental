<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Open source TWAIN scanning library. Replaces the proprietary ImagingDeviceManager.dll,
    which wrapped the commercial EZTwain library (Eztwain4.dll). Talks directly to the standard
    TWAIN Data Source Manager (TWAINDSM.dll, or the legacy twain_32.dll) through P/Invoke.
    Built for net10.0-windows x64 like the program (Directory.Build.props, Directory.Build.Net.props; S3b-2 of docs/specs/net10-plan.md):
    TWAIN runs in the 64-bit process through the 64-bit TWAINDSM.dll of the system folder only (NativeTwainDsm, S3a-12; the setup installs
    it, S3b-7).
    Every .cs file under this folder is compiled, so packages that add files never conflict over this project file.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- The status and Cancel window and the notices of device acquisitions (UI folder) are Windows Forms. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ImagingDeviceManager</RootNamespace>
    <AssemblyName>ImagingDeviceManager</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' != 'Debug' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\third-party\build\PdfSharp-gdi\PdfSharp-gdi.csproj" />
  </ItemGroup>
  <!--
    Doubles and floats written as text as .NET Framework wrote them (package S3b-FMT of the .NET 10 move, decision 24 of
    docs/specs/net10-plan.md, docs/port-notes/S3b-FMT.md): CodeBase's ODNumberText.ToStringNetFx and AsNetFx, compiled in as an internal
    class (OD_NUMBERTEXT_LINKED), since this project does not reference CodeBase.
  -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);OD_NUMBERTEXT_LINKED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\CodeBase\Utilities\ODNumberTextNetFx.cs">
      <Link>Utilities\ODNumberTextNetFx.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
