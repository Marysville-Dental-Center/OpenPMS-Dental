<?xml version="1.0" encoding="utf-8"?>
<!--
  The IIS option of the Middle Tier server (package S3b-6 of the .NET 10 move, docs/port-notes/S3b-6.md): the ASP.NET Core Module runs the
  self-contained OpenPmsDentalServer.exe in-process, in a 64-bit application pool (the IIS default). The module comes with the .NET 10 Hosting
  Bundle, installed for it alone (OPT_NO_RUNTIME=1 OPT_NO_SHAREDFX=1): the server carries its own runtimes. The IIS application's virtual
  path (/OpenDentalServer) is the endpoint's path base; the site needs an HTTPS binding, since the server refuses plain HTTP. The Windows
  service, the default way to run the server, does not read this file.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\OpenPmsDentalServer.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- 1 GiB, as the server's own limit (OpenDentalServer:MaxRequestBodySize in appsettings.json) and the old Web.config. -->
          <requestLimits maxAllowedContentLength="1073741824" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
