<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The Middle Tier server on ASP.NET Core (stage 3b of the .NET 10 move, package S3b-6: docs/specs/net10-plan.md, the S3b-6 row;
    docs/port-notes/S3b-6.md). It replaces the ASMX web service of .NET Framework (ServiceMain.asmx, its code-behind and Web.config):
    one POST endpoint at {PathBase}/ServiceMain.asmx and {PathBase}/ (PathBase /OpenDentalServer by default) takes the serialized DTO as
    the raw UTF-8 body and answers with DtoProcessor.ProcessDto's result, HTTPS only. It runs as a Windows service by default
    (Microsoft.Extensions.Hosting.WindowsServices) or in IIS in-process (web.config). No SOAP: the client (OpenPmsDentalBusiness,
    WebServices\OpenDentalServerHttp.cs) and the server switch together.

    net10.0-windows x64 and a self-contained win-x64 exe from Directory.Build.props and Directory.Build.Net.props (decisions 19 and 20): it
    is published into its own folder on its host with the NETCore, WindowsDesktop and ASP.NET Core runtimes, so the host installs nothing
    for .NET. The SDK's default globs compile every .cs file under this folder and make appsettings.json and web.config content (bin\ and
    obj\ excepted). OpenDentalServerConfig.xml is the sample of the database settings the server reads from its folder; as before, the
    build does not copy it (an edited copy next to the exe is never overwritten).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenPmsDentalServer</RootNamespace>
    <AssemblyName>OpenPmsDentalServer</AssemblyName>
    <!-- C# 8.0, pinned (S3b-1): the host is written without the C# 10 forms of the minimal API (lambda endpoints), as S3b-0 item 4 allows. -->
    <LangVersion>8.0</LangVersion>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <!-- The business library names Windows Forms and WPF types; the Windows Desktop framework is named here too, so the restore prunes the
         packages that framework holds (S3b-3, section 1). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Not a NuGet package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- UseWindowsService: the Windows service host, the service's start and stop, and its event log. The version of Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
