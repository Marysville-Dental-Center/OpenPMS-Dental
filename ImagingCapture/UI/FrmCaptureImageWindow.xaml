<local:FrmODBase x:Class="ImagingCapture.UI.FrmCaptureImageWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OpenPmsDental;assembly=WpfControlsOD"
             mc:Ignorable="d"
             Width="900" Height="700"
             Text="X-ray" >
	<!--The session's newest image in its own window: an ordinary window (move it to another monitor, maximise it), the image filling it-->
	<Grid Background="Black" >
		<Image x:Name="imageShown" Stretch="Uniform" Margin="8" />
	</Grid>
</local:FrmODBase>
